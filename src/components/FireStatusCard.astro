---
import { ALL_LIFESTYLE_TIERS, LIFESTYLE_LABELS, formatFireNumber } from '../data/fireNumber';
import type { LifestyleTier } from '../data/fireNumber';

interface Props {
  cityName: string;
  country: string;
  fireNumbers: Record<LifestyleTier, { fireNumber: number; monthlyCost: number }>;
}

const { cityName, country, fireNumbers } = Astro.props;
---

<div id="fire-status-card" class="hidden bg-gradient-to-br from-brand-50 to-sand-50 rounded-2xl border border-brand-100 shadow-sm p-6 sm:p-8">
  <h3 id="fire-status-headline" class="font-serif text-xl sm:text-2xl font-bold text-brand-950 mb-5"></h3>

  <div class="space-y-2.5 mb-5">
    {ALL_LIFESTYLE_TIERS.map((tier) => {
      const data = fireNumbers[tier];
      return (
        <div
          class="fire-status-row flex items-center justify-between py-2.5 px-4 rounded-xl transition-colors"
          data-tier={tier}
          data-fire-number={data ? data.fireNumber : ''}
          data-monthly-cost={data ? data.monthlyCost : ''}
        >
          <span class="text-sm font-semibold text-brand-950">{LIFESTYLE_LABELS[tier]}</span>
          <span class="fire-status-signal text-sm font-medium"></span>
        </div>
      );
    })}
  </div>

  <p id="fire-status-portfolio" class="text-xs text-gray-400 mb-2"></p>
  <p id="fire-status-passive-note" class="text-xs text-gray-400 mb-5 hidden"></p>

  <div class="relative inline-block">
    <button
      id="fire-status-share"
      type="button"
      class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-xl bg-brand-600 text-white hover:bg-brand-700 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
      </svg>
      Share This
    </button>
    <div id="fire-status-toast" class="absolute -top-10 left-1/2 -translate-x-1/2 hidden">
      <div class="bg-brand-950 text-white text-xs font-medium px-4 py-2 rounded-full shadow-lg whitespace-nowrap">
        Link copied!
      </div>
    </div>
  </div>
</div>

<script define:vars={{ cityName, country }}>
  (function() {
    let portfolio = 0;
    let userPassiveIncome = 0;

    // Session-first, matching the host city page's precedence (the session is
    // the user's latest explicit numbers; the URL can be stale after back-nav).
    function ssGet(key) {
      try { return sessionStorage.getItem('pa:' + key); } catch (e) { return null; }
    }
    const params = new URLSearchParams(window.location.search);
    const nwParam = ssGet('portfolio') || params.get('portfolio') || params.get('nw');
    if (nwParam) {
      portfolio = parseInt(nwParam, 10) || 0;
    }
    const passiveParam = parseInt(ssGet('passive') || params.get('passive') || '0', 10);
    if (passiveParam > 0) userPassiveIncome = passiveParam;

    if (!portfolio || portfolio <= 0) return;

    const card = document.getElementById('fire-status-card');
    if (!card) return;

    function fmtPortfolio(n) {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      }).format(n);
    }

    const rows = card.querySelectorAll('.fire-status-row');

    // Verdict = historical-backtest survival per tier, computed by the host page
    // and exposed on window (this define:vars component cannot import the engine).
    function renderVerdict() {
      const surv = window.__paTierSurvival;
      const classify = window.__paClassify;
      const threshold = window.__paThreshold;
      if (!surv || !classify || threshold == null) return false;
      let anyRetire = false;

      rows.forEach((row) => {
        const tier = row.getAttribute('data-tier') || '';
        const signal = row.querySelector('.fire-status-signal');
        if (!signal) return;
        const survival = surv[tier];
        if (survival === undefined) {
          signal.textContent = 'Data unavailable';
          signal.classList.add('text-gray-400');
          row.classList.add('bg-gray-50');
          return;
        }
        const band = classify(survival, threshold);
        const pct = survival === null ? null : Math.round(survival * 100);
        row.classList.remove('bg-emerald-50/60', 'bg-amber-50/50', 'bg-white/60');
        if (band === 'retire') {
          anyRetire = true;
          signal.innerHTML = `<span class="inline-flex items-center gap-1.5 text-emerald-600">&#x2705; You can retire here${pct !== null ? ` · ${pct}%` : ''}</span>`;
          row.classList.add('bg-emerald-50/60');
        } else if (band === 'caution') {
          signal.innerHTML = `<span class="text-amber-600 font-medium">Close${pct !== null ? ` · ${pct}%` : ''}</span>`;
          row.classList.add('bg-amber-50/50');
        } else {
          signal.innerHTML = `<span class="text-gray-500">Not quite yet${pct !== null ? ` · ${pct}%` : ''}</span>`;
          row.classList.add('bg-white/60');
        }
      });

      const headline = document.getElementById('fire-status-headline');
      if (headline) {
        headline.textContent = anyRetire
          ? `You could retire in ${cityName}, ${country} today.`
          : `You're on your way to ${cityName}, ${country}.`;
      }
      card.classList.remove('hidden');
      return true;
    }

    const portfolioLine = document.getElementById('fire-status-portfolio');
    if (portfolioLine) {
      portfolioLine.textContent = `Portfolio: ${fmtPortfolio(portfolio)}`;
    }

    if (userPassiveIncome > 0) {
      const passiveNote = document.getElementById('fire-status-passive-note');
      if (passiveNote) {
        const fmtPI = userPassiveIncome >= 1000 ? '$' + Math.round(userPassiveIncome / 1000) + 'K' : '$' + userPassiveIncome;
        passiveNote.textContent = `Adjusted for your ${fmtPI}/yr passive income`;
        passiveNote.classList.remove('hidden');
      }
    }

    // The host page computes per-tier survival after parse; render when it's ready
    // (renderVerdict reveals the card). Re-render on EVERY dispatch, not once, so a
    // live change (e.g. the healthcare override) updates the card too.
    renderVerdict();
    window.addEventListener('pa:survival-ready', renderVerdict);

    const shareBtn = document.getElementById('fire-status-share');
    const toast = document.getElementById('fire-status-toast');
    shareBtn?.addEventListener('click', () => {
      const url = new URL(window.location.href);
      if (!url.searchParams.get('portfolio') && !url.searchParams.get('nw')) {
        url.searchParams.set('portfolio', String(portfolio));
      }
      navigator.clipboard.writeText(url.toString()).then(() => {
        if (toast) {
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 2000);
        }
      });
    });
  })();
</script>
