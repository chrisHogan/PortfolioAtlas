  // ─── Years Until Affordable ───
  function yearsUntilAffordable(currentPortfolio, fireNumber, savings) {
    if (savings <= 0 || currentPortfolio >= fireNumber) return null;
    let p = currentPortfolio;
    for (let y = 1; y <= 30; y++) {
      p = (p + savings) * 1.07;
      if (p >= fireNumber) return y;
    }
    return null; // >30 years
  }

  function getYearsHTML(years) {
    if (years === null) return '';
    let colorClass;
    if (years <= 3) colorClass = 'text-amber-600';
    else if (years <= 10) colorClass = 'text-gray-500';
    else colorClass = 'text-gray-400';
    return `<div class="mt-1 group/tip relative inline-block">
      <span class="text-xs font-medium ${colorClass} cursor-help">Affordable in ~${years} ${years === 1 ? 'year' : 'years'}</span>
      <div class="absolute bottom-full left-0 mb-1 hidden group-hover/tip:block z-10 w-56 px-3 py-2 text-[10px] text-white bg-gray-800 rounded-lg shadow-lg">
        Estimate assumes 7% annual growth and your stated savings rate. Actual results will vary.
      </div>
    </div>`;
  }

  // ─── Region / Country multi-select filter ───
  (function setupRegionFilter() {
    const htmlEsc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');

    // Build region -> {country -> count} from cities that actually exist (no empties).
    const tree = {};
    for (const c of cityData) {
      if (!tree[c.region]) tree[c.region] = {};
      tree[c.region][c.country] = (tree[c.region][c.country] || 0) + 1;
    }
    const orderedRegions = REGION_ORDER.filter((r) => tree[r]);        // ordered, present-only
    const knownCountries = new Set(cityData.map((c) => c.country));
    const countriesOf = (region) => Object.keys(tree[region] || {}).sort((a, b) => a.localeCompare(b));
    const regionTotal = (region) => Object.values(tree[region] || {}).reduce((s, n) => s + n, 0);
    const selCount = (region) => countriesOf(region).filter((c) => selectedCountries.has(c)).length;
    const isFull = (region) => { const cs = countriesOf(region); return cs.length > 0 && cs.every((c) => selectedCountries.has(c)); };

    const wrap = document.getElementById('region-filter');
    const trigger = document.getElementById('region-trigger');
    const triggerLabel = document.getElementById('region-trigger-label');
    const panel = document.getElementById('region-panel');
    const search = document.getElementById('region-search');
    const treeEl = document.getElementById('region-tree');
    const chipsEl = document.getElementById('region-chips');
    if (!wrap || !trigger || !panel || !treeEl || !chipsEl) return;

    function buildTree(q) {
      const query = (q || '').toLowerCase().trim();
      let html = '';
      for (const region of orderedRegions) {
        const regionMatch = region.toLowerCase().includes(query);
        const cs = countriesOf(region);
        const shown = (!query || regionMatch) ? cs : cs.filter((c) => c.toLowerCase().includes(query));
        if (shown.length === 0 && !regionMatch) continue;
        html += '<div class="mb-1">'
          + '<label class="flex items-center gap-2 py-1.5 px-1 rounded-md hover:bg-sand-50 cursor-pointer font-semibold text-sm text-brand-950">'
          + `<input type="checkbox" data-region-header="${htmlEsc(region)}" class="w-4 h-4 accent-brand-600 shrink-0">`
          + `<span class="flex-1">${htmlEsc(region)}</span><span class="text-[11px] text-gray-400">${regionTotal(region)}</span></label>`
          + '<div class="pl-6">';
        for (const country of shown) {
          html += '<label class="flex items-center gap-2 py-1.5 px-1 rounded-md hover:bg-sand-50 cursor-pointer text-sm text-gray-700">'
            + `<input type="checkbox" data-country="${htmlEsc(country)}" data-region="${htmlEsc(region)}" class="w-4 h-4 accent-brand-600 shrink-0">`
            + `<span class="flex-1">${htmlEsc(country)}</span><span class="text-[11px] text-gray-400">${tree[region][country]}</span></label>`;
        }
        html += '</div></div>';
      }
      treeEl.innerHTML = html || '<div class="py-4 text-center text-sm text-gray-400">No matches</div>';
      syncChecks();
    }

    // Header tri-state via the native .indeterminate property (NOT an attribute).
    function syncChecks() {
      treeEl.querySelectorAll('input[data-country]').forEach((cb) => {
        cb.checked = selectedCountries.has(cb.getAttribute('data-country'));
      });
      treeEl.querySelectorAll('input[data-region-header]').forEach((cb) => {
        const region = cb.getAttribute('data-region-header');
        const sel = selCount(region), total = countriesOf(region).length;
        cb.checked = total > 0 && sel === total;
        cb.indeterminate = sel > 0 && sel < total;
      });
    }

    // A country can belong to >1 region (e.g. Mexico is in Latin America AND Caribbean).
    const regionsOfCountry = (country) => orderedRegions.filter((r) => tree[r][country] != null);

    // Chip list, built once and reused for the trigger count:
    //  - one chip per fully-selected region (collapse), then
    //  - selected countries NOT already covered by a full-region chip, deduped.
    function chipItems() {
      const items = [];
      const seen = new Set();
      for (const region of orderedRegions) if (isFull(region)) items.push({ label: region, kind: 'region', value: region });
      for (const region of orderedRegions) for (const country of countriesOf(region)) {
        if (!selectedCountries.has(country) || seen.has(country)) continue;
        seen.add(country);
        if (regionsOfCountry(country).some((r) => isFull(r))) continue; // covered by a region chip
        items.push({ label: country, kind: 'country', value: country });
      }
      return items;
    }
    function updateTrigger() {
      const n = chipItems().length;
      triggerLabel.textContent = n === 0 ? 'All regions' : (n + ' selected');
      trigger.classList.toggle('active', selectedCountries.size > 0);
    }

    function chip(label, kind, value) {
      return '<span class="inline-flex items-center gap-1 pl-2.5 pr-1.5 py-1 text-xs font-medium rounded-full bg-brand-50 text-brand-700 border border-brand-200">'
        + htmlEsc(label)
        + `<button type="button" data-remove-${kind}="${htmlEsc(value)}" aria-label="Remove ${htmlEsc(label)}" class="text-brand-400 hover:text-brand-800 leading-none">✕</button></span>`;
    }
    function renderChips() {
      let html = chipItems().map((i) => chip(i.label, i.kind, i.value)).join('');
      if (selectedCountries.size > 0) html += '<button type="button" id="region-clear-all" class="text-xs text-gray-500 hover:text-gray-700 underline ml-1">Clear all</button>';
      chipsEl.innerHTML = html;
    }

    function onChange() {
      syncChecks(); renderChips(); updateTrigger();
      if (typeof gtag === 'function') gtag('event', 'filter_applied', { filter_type: 'countries', filter_value: selectedCountries.size });
      if (portfolio > 0) { resetSectionCounts(); renderResults(); }
    }

    // Exposed so restore() (which populates selectedCountries from ?countries) can refresh the UI.
    window.__paSyncRegion = function () { buildTree(search ? search.value : ''); renderChips(); updateTrigger(); };
    window.__paKnownCountries = knownCountries;

    // ── Events ──
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !panel.classList.toggle('hidden');
      trigger.setAttribute('aria-expanded', String(open));
      if (open && search) search.focus();
    });
    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target)) { panel.classList.add('hidden'); trigger.setAttribute('aria-expanded', 'false'); }
    });
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { panel.classList.add('hidden'); trigger.setAttribute('aria-expanded', 'false'); trigger.focus(); }
    });
    if (search) search.addEventListener('input', () => buildTree(search.value));

    treeEl.addEventListener('change', (e) => {
      const t = e.target;
      if (!t.matches) return;
      if (t.matches('input[data-region-header]')) {
        const region = t.getAttribute('data-region-header');
        if (t.checked) countriesOf(region).forEach((c) => selectedCountries.add(c));
        else countriesOf(region).forEach((c) => selectedCountries.delete(c));
        onChange();
      } else if (t.matches('input[data-country]')) {
        const country = t.getAttribute('data-country');
        if (t.checked) selectedCountries.add(country); else selectedCountries.delete(country);
        onChange();
      }
    });

    chipsEl.addEventListener('click', (e) => {
      const rr = e.target.closest('[data-remove-region]');
      const rc = e.target.closest('[data-remove-country]');
      if (rr) { countriesOf(rr.getAttribute('data-remove-region')).forEach((c) => selectedCountries.delete(c)); onChange(); }
      else if (rc) { selectedCountries.delete(rc.getAttribute('data-remove-country')); onChange(); }
      else if (e.target.id === 'region-clear-all') { selectedCountries.clear(); onChange(); }
    });

    // Initial paint (selection may be populated later by restore()).
    buildTree(''); renderChips(); updateTrigger();
  })();

  // ─── Filter Logic ───
  function passesFilters(city) {
    // Region/country: empty selection = all; otherwise the city's country must be selected.
    if (selectedCountries.size > 0 && !selectedCountries.has(city.country)) return false;
    if (filters.climate === 'warm' && !warmClimates.includes(city.tags.climate)) return false;
    if (filters.climate === 'mild' && !mildClimates.includes(city.tags.climate)) return false;
    if (filters.eng === 'yes' && city.tags.english !== 'Widely spoken') return false;
    if (filters.hc === 'good' && !['Excellent', 'Good'].includes(city.tags.healthcare)) return false;
    if (filters.hc === 'excellent' && city.tags.healthcare !== 'Excellent') return false;
    return true;
  }

  // ─── Portfolio Fit ───
  function getPortfolioFit(portfolioValue, cityFireNumber) {
    if (cityFireNumber <= 0) return 'over_resourced';
    const ratio = portfolioValue / cityFireNumber;
    if (ratio < 1) return 'not_affordable';
    if (ratio <= 2.5) return 'perfect_fit';
    if (ratio <= 5) return 'within_reach';
    return 'over_resourced';
  }

  // ─── Region summary helper ───
  function getRegionSummary(cities) {
    const regionCounts = {};
    cities.forEach((c) => { regionCounts[c.region] = (regionCounts[c.region] || 0) + 1; });
    const sorted = Object.entries(regionCounts).sort((a, b) => b[1] - a[1]);
    const topRegions = sorted.slice(0, 3).map(([r]) => r);
    return topRegions.length > 0 ? topRegions.join(', ') : 'various regions';
  }

  // ─── Build city card HTML ───
  function buildCardHTML(city) {
    const tagPills = [
      { label: city.tags.climate, cat: 'climate' },
      { label: city.tags.safety, cat: 'safety' },
      { label: city.tags.english, cat: 'english' },
    ].filter((t) => t.label).slice(0, 3);

    const tagTooltips = { climate: 'Climate', safety: 'Safety rating', english: 'English proficiency', visa: 'Visa ease' };
    const tagHTML = tagPills.map((t) =>
      `<span title="${tagTooltips[t.cat] || t.cat}: ${t.label}" class="text-[10px] font-medium px-2 py-0.5 rounded-full ${getTagColorClient(t.cat, t.label)}">${t.label}</span>`
    ).join('');

    const pct = (city.survival === null || city.survival === undefined) ? null : Math.round(city.survival * 100);

    let signalHTML;
    if (city.fitTier === 'over_resourced') {
      signalHTML = '<div class="flex items-center gap-1.5 mt-1"><svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-sm font-medium text-gray-400">Easily affordable</span></div>';
    } else if (city.green) {
      signalHTML = '<div class="flex items-center gap-1.5 mt-1"><svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-sm font-semibold text-emerald-600">You can retire here</span></div>';
    } else {
      // Years-to-affordable now grows toward the backtest target (city.needed).
      const years = (annualSavings > 0 && city.needed != null) ? yearsUntilAffordable(portfolio, city.needed, annualSavings) : null;
      const yearsProjection = getYearsHTML(years);
      const pctTxt = pct !== null ? `Not quite yet · survived ${pct}%` : 'Not quite yet';
      signalHTML = `<p class="text-sm text-gray-500 mt-1">${pctTxt}</p>${yearsProjection}`;
    }

    // Fit label
    let fitLabelHTML = '';
    if (city.fitTier === 'within_reach') {
      fitLabelHTML = '<span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-blue-50 text-blue-600">Well within your means</span>';
    }

    // "Now in range" indicator for premium unlock cities
    let unlockHTML = '';
    if (city.justUnlocked) {
      unlockHTML = '<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-violet-50 text-violet-600 border border-violet-200">Now in range</span>';
    }

    const isOverResourced = city.fitTier === 'over_resourced';
    const barColor = isOverResourced ? 'from-gray-300 to-gray-400' : (city.green ? 'from-emerald-400 to-emerald-500' : 'from-brand-500 to-brand-600');
    const cardOpacity = isOverResourced ? 'opacity-70' : '';

    return `<a href="/cities/${city.slug}" class="city-card block group ${cardOpacity}">
      <div class="h-2 bg-gradient-to-r ${barColor}"></div>
      <div class="p-5">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="text-2xl">${city.emoji}</span>
            <div>
              <h3 class="font-serif font-bold text-lg text-brand-950 group-hover:text-brand-600 transition-colors">${city.name}</h3>
              <p class="text-sm text-gray-500">${city.country}</p>
            </div>
          </div>
          <div class="fire-score w-10 h-10 text-sm ${getScoreClass(city.fireScore)}">${city.fireScore.toFixed(1)}</div>
        </div>
        <div class="mb-3">
          <div class="flex items-baseline justify-between">
            <span class="text-xs text-gray-500">Needed to retire here</span>
            <span class="text-lg font-bold text-brand-700">${city.needed != null ? fmtCompact(city.needed) : '—'}</span>
          </div>
          ${signalHTML}
        </div>
        <div class="flex flex-wrap gap-1.5 mb-3">${tagHTML} ${fitLabelHTML} ${unlockHTML}</div>
        <div class="flex items-center justify-between pt-3 border-t border-sand-100">
          <p class="text-xs text-gray-400">From ${fmt(city.monthlyCost)}/mo</p>
          <span class="text-xs font-medium text-brand-600 bg-brand-50 px-3 py-1 rounded-full">${city.region}</span>
        </div>
      </div>
    </a>`;
  }

  // ─── Render Results ───
  function renderResults() {
    fallbackSection?.classList.add('hidden');
    resultsSection?.classList.remove('hidden');
    document.getElementById('reverse-flow')?.classList.add('hidden');

    // The engine bundle is deferred (loads after first paint). Until it's ready,
    // show a brief analyzing state and re-render on the ready event.
    if (!window.__paBacktest) {
      citySections.innerHTML = `<div class="py-16 text-center text-sm text-gray-400">Backtesting ${cityData.length} cities against market history…</div>`;
      noCities?.classList.add('hidden');
      window.addEventListener('pa:engine-ready', () => renderResults(), { once: true });
      return;
    }

    // Heavy step (~112 backtests) runs AFTER paint and is cached per
    // portfolio|tier|horizon — only recompute when one of those changes.
    const survivalKey = portfolio + '|' + lifestyle + '|' + horizonYears + '|' + passiveIncome + '|' + hcToken() + '|' + adultsToken();
    if (survivalKey !== lastSurvivalKey) {
      citySections.innerHTML = `<div class="py-16 text-center text-sm text-gray-400">Backtesting ${cityData.length} cities against market history…</div>`;
      noCities?.classList.add('hidden');
      requestAnimationFrame(() => {
        cityData.forEach((c) => citySurvival(c)); // warm the cache for this key
        lastSurvivalKey = survivalKey;
        renderResults();
      });
      return;
    }

    const RETIRE = threshold();

    // State visibility: when pricing for 2 adults, swap the one-person base
    // note for a clear "Showing costs for 2 adults" indicator.
    document.querySelectorAll('.household-note').forEach((el) => el.classList.toggle('hidden', adults <= 1));
    document.querySelectorAll('.household-base-note').forEach((el) => el.classList.toggle('hidden', adults > 1));

    // Compute the verdict (backtest survival) + display bucket for each city.
    const allComputed = cityData
      .filter(passesFilters)
      .map((city) => {
        const tierData = city.tiers[lifestyle];
        const monthlyCost = adjustedMonthly(city);   // reflects the healthcare override
        const survival = citySurvival(city);   // 0..1 or null
        const needed = cityNeeded(city);        // solver target at the chosen threshold (or null)
        const green = survival !== null && survival !== undefined && survival >= RETIRE;
        const gap = (needed != null) ? portfolio - needed : -Infinity;
        // Ratio of portfolio to the (consistent) target sub-groups the green set
        // for display only; survival is the gate.
        const ratio = (needed != null && needed > 0) ? portfolio / needed : (needed === 0 ? Infinity : 0);
        let fitTier;
        if (!green) fitTier = 'not_affordable';
        else if (ratio > 5) fitTier = 'over_resourced';
        else if (ratio > 2.5) fitTier = 'within_reach';
        else fitTier = 'perfect_fit';
        const justUnlocked = city.unlockThreshold > 0 && portfolio >= city.unlockThreshold && fitTier === 'perfect_fit';
        return { ...city, needed, monthlyCost, survival, green, gap, fitTier, justUnlocked };
      });

    // Bucket into sections
    const sweetSpot = allComputed.filter((c) => c.fitTier === 'perfect_fit');
    const withinReach = allComputed.filter((c) => c.fitTier === 'within_reach');
    const stretchGoals = allComputed.filter((c) => c.fitTier === 'not_affordable');
    const overResourced = allComputed.filter((c) => c.fitTier === 'over_resourced');

    // Sort within each bucket
    sweetSpot.sort((a, b) => {
      if (a.justUnlocked !== b.justUnlocked) return a.justUnlocked ? -1 : 1;
      return b.fireScore - a.fireScore;
    });
    withinReach.sort((a, b) => b.fireScore - a.fireScore);
    stretchGoals.sort((a, b) => (b.survival ?? -1) - (a.survival ?? -1)); // closest to retiring first
    overResourced.sort((a, b) => b.fireScore - a.fireScore);

    const totalFiltered = allComputed.length;

    const lifestyleLabelMap = { budget: 'Lean FIRE', comfortable: 'FIRE', luxury: 'Fat FIRE' };
    const lifestyleLabel = lifestyleLabelMap[lifestyle] || lifestyle;

    // Update summary with portfolio-aware framing
    if (summaryEl) {
      if (sweetSpot.length > 0) {
        const regionHint = getRegionSummary(sweetSpot);
        summaryEl.innerHTML = `<strong>${fmtPortfolio(portfolio)}</strong> portfolio: <strong>${sweetSpot.length}</strong> ${sweetSpot.length === 1 ? 'city' : 'cities'} perfectly matched for <strong>${lifestyleLabel}</strong>, including ${regionHint}`;
      } else if (withinReach.length > 0) {
        summaryEl.innerHTML = `Your <strong>${fmtPortfolio(portfolio)}</strong> portfolio easily covers <strong>${withinReach.length}</strong> ${lifestyleLabel} ${withinReach.length === 1 ? 'city' : 'cities'} — consider a higher lifestyle tier`;
      } else if (stretchGoals.length > 0) {
        summaryEl.innerHTML = `Your <strong>${fmtPortfolio(portfolio)}</strong> portfolio isn't quite there yet for <strong>${lifestyleLabel}</strong> — <strong>${stretchGoals.length}</strong> ${stretchGoals.length === 1 ? 'city is' : 'cities are'} within reach as you save more`;
      } else {
        summaryEl.innerHTML = `Your <strong>${fmtPortfolio(portfolio)}</strong> portfolio at <strong>${lifestyleLabel}</strong>`;
      }
    }

    if (totalFiltered === 0) {
      citySections.innerHTML = '';
      noCities?.classList.remove('hidden');
      updateURL();
      return;
    }
    noCities?.classList.add('hidden');

    // Helper: build a section with its own show-more button
    function buildSection(id, title, subtitle, items, limit) {
      if (items.length === 0) return '';
      const visible = items.slice(0, limit);
      const hasMore = items.length > limit;
      let html = `<div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <h2 class="font-serif text-xl font-bold text-brand-950">${title}</h2>
          <span class="text-xs font-medium text-gray-400">${items.length} ${items.length === 1 ? 'city' : 'cities'}</span>
        </div>
        <p class="text-sm text-gray-500 mb-4">${subtitle}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          ${visible.map(buildCardHTML).join('')}
        </div>`;
      if (hasMore) {
        html += `<div class="text-center pt-5">
          <button type="button" data-show-more="${id}" class="px-8 py-2.5 bg-white border border-sand-200 rounded-full text-sm font-medium text-gray-700 hover:bg-sand-50 transition-all">
            Show more cities
          </button>
          <p class="text-xs text-gray-400 mt-2">Showing ${visible.length} of ${items.length}</p>
        </div>`;
      }
      html += `</div>`;
      return html;
    }

    // Build sections HTML
    let html = '';

    html += buildSection('perfect_fit', 'Your sweet spot',
      'Cities where your portfolio is the right size — enough to retire comfortably with a healthy buffer.',
      sweetSpot, sectionVisibleCounts.perfect_fit);

    html += buildSection('within_reach', 'Also within reach',
      'Affordable, but your portfolio exceeds what you\'d need here. Consider a higher lifestyle tier.',
      withinReach, sectionVisibleCounts.within_reach);

    html += buildSection('not_affordable', 'Stretch goals',
      'Not yet affordable — but within reach as your portfolio grows.',
      stretchGoals, sectionVisibleCounts.not_affordable);

    // Over-resourced (collapsed)
    if (overResourced.length > 0) {
      html += `<div class="mb-8">
        <button id="over-resourced-toggle" type="button" class="flex items-center gap-2 text-sm font-medium text-gray-400 hover:text-gray-600 transition-colors py-3">
          <svg id="over-resourced-chevron" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          Show ${overResourced.length} budget-friendly ${overResourced.length === 1 ? 'option' : 'options'} below your wealth level
        </button>
        <div id="over-resourced-grid" class="hidden mt-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            ${overResourced.map(buildCardHTML).join('')}
          </div>
        </div>
      </div>`;
    }

    citySections.innerHTML = html;

    // Wire up per-section show-more buttons
    citySections.querySelectorAll('[data-show-more]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sectionKey = btn.dataset.showMore;
        sectionVisibleCounts[sectionKey] += 12;
        renderResults();
      });
    });

    // Wire up over-resourced toggle
    const orToggle = document.getElementById('over-resourced-toggle');
    const orGrid = document.getElementById('over-resourced-grid');
    const orChevron = document.getElementById('over-resourced-chevron');
    orToggle?.addEventListener('click', () => {
      const isHidden = orGrid?.classList.contains('hidden');
      if (isHidden) {
        orGrid?.classList.remove('hidden');
        if (orChevron) orChevron.style.transform = 'rotate(90deg)';
      } else {
        orGrid?.classList.add('hidden');
        if (orChevron) orChevron.style.transform = '';
      }
    });

    updateURL();

    // ─── GA4: City Clicked ───
    citySections.querySelectorAll('.city-card').forEach((card) => {
      card.addEventListener('click', () => {
        const nameEl = card.querySelector('h3');
        if (nameEl && typeof gtag === 'function') {
          gtag('event', 'city_clicked', { 'city_name': nameEl.textContent.trim() });
        }
      });
    });
  }

  // ─── State Propagation (no persistence) ───
  // Entered values live only in memory + the address bar of explicitly-shared
  // links. They are never written to localStorage, and the homepage never seeds
  // its own URL — so a refresh or a return visit starts from a clean slate.
  const tierToUrlKey = { budget: 'leanfire', comfortable: 'fire', luxury: 'fatfire' };
  const urlKeyToTier = { leanfire: 'budget', fire: 'comfortable', fatfire: 'luxury' };

  // Query string (portfolio + passive) carried onto internal links so the
  // current numbers travel with the user when they navigate to another page.
  function carryQuery() {
    const p = new URLSearchParams();
    if (portfolio > 0) p.set('portfolio', String(portfolio));
    if (passiveIncome > 0) p.set('passive', String(passiveIncome));
    // Carry the rate + horizon so city pages compute the same map and backtest.
    if (confPct !== 90) p.set('conf', String(confPct));
    if (horizonYears !== 30) p.set('horizon', String(horizonYears));
    // Carry the selected lifestyle tier so the city page defaults to the SAME tier
    // (omitted when it's the 'comfortable'/FIRE default — the city page defaults to it).
    if (lifestyle !== 'comfortable') p.set('tier', tierToUrlKey[lifestyle] || lifestyle);
    // Carry the healthcare override so the city page re-prices with the same figure.
    if (healthcareOverride != null) p.set('hcusd', String(healthcareOverride));
    // Carry the household size (omitted when 1 — the single-adult default).
    if (adults > 1) p.set('adults', String(adults));
    const qs = p.toString();
    return qs ? '?' + qs : '';
  }

  // Append the carry query to all internal links (skip hash/external links).
  function decorateInternalLinks() {
    const qs = carryQuery();
    document.querySelectorAll('a[href^="/"]').forEach((a) => {
      const href = a.getAttribute('href');
      if (!href || href.startsWith('//') || href.includes('#')) return;
      a.setAttribute('href', href.split('?')[0] + qs);
    });
  }

  // Build a full shareable URL on demand (used by the Share button only).
  function buildShareUrl() {
    const params = new URLSearchParams();
    if (portfolio > 0) params.set('portfolio', String(portfolio));
    if (lifestyle !== 'comfortable') params.set('tier', tierToUrlKey[lifestyle] || lifestyle);
    if (selectedCountries.size > 0) params.set('countries', [...selectedCountries].map(encodeURIComponent).join(','));
    if (filters.climate) params.set('climate', filters.climate);
    if (filters.eng) params.set('eng', filters.eng);
    if (filters.hc) params.set('hc', filters.hc);
    if (annualSavings > 0) params.set('save', String(annualSavings));
    if (passiveIncome > 0) params.set('passive', String(passiveIncome));
    if (confPct !== 90) params.set('conf', String(confPct));
    if (horizonYears !== 30) params.set('horizon', String(horizonYears));
    if (healthcareOverride != null) params.set('hcusd', String(healthcareOverride));
    if (adults > 1) params.set('adults', String(adults));
    const qs = params.toString();
    return window.location.origin + '/' + (qs ? '?' + qs : '');
  }

  // Called at the end of each render (in place of the old URL/localStorage
  // write). Keeps internal links in sync with the current numbers.
  function updateURL() {
    decorateInternalLinks();
  }

  // ─── Restore from URL only (shared/bookmarked links) ───
  // Values are intentionally NOT persisted to localStorage, so a refresh of a
  // clean homepage URL or a return visit always starts from a blank slate.
  function restore() {
    const params = new URLSearchParams(window.location.search);
    // Support new params (portfolio, tier, region) with fallback to old (nw,
    // lifestyle, loc). Each personal input resolves URL-first with the session
    // as fallback (see resolveParam above).
    let nw = parseInt(resolveParam('portfolio', params.get('portfolio') || params.get('nw')) || '0', 10);
    let tierParam = params.get('tier') || '';
    let ls = tierParam ? (urlKeyToTier[tierParam] || '') : (params.get('lifestyle') || '');
    if (ls && ['budget', 'comfortable', 'luxury'].includes(ls)) ssSet('tier', ls);
    else {
      const st = ssGet('tier');
      if (st && ['budget', 'comfortable', 'luxury'].includes(st)) ls = st;
    }

    // Restore annual savings and passive income (URL, then session)
    const saveParam = parseInt(resolveParam('save', params.get('save')) || '0', 10);
    if (saveParam > 0) annualSavings = saveParam;
    const passiveParam = parseInt(resolveParam('passive', params.get('passive')) || '0', 10);
    if (passiveParam > 0) passiveIncome = passiveParam;

    // Restore confidence and horizon (validated to the slider range)
    const confParam = parseInt(resolveParam('conf', params.get('conf')) || '', 10);
    if (confParam === 80 || confParam === 90 || confParam === 95) confPct = confParam;
    const horizonParam = parseInt(resolveParam('horizon', params.get('horizon')) || '', 10);
    if (!isNaN(horizonParam) && horizonParam >= 20 && horizonParam <= 60) horizonYears = horizonParam;
    updateConfLabel(); setConfActive();
    if (horizonInput) { horizonInput.value = String(horizonYears); updateHorizonLabel(); }

    // Restore household size. Only "2" is meaningful today; anything else
    // keeps the single-adult default.
    const adultsResolved = resolveParam('adults', params.get('adults'));
    if (adultsResolved != null && parseInt(adultsResolved, 10) === 2) adults = 2;
    setAdultsActive();

    // Restore healthcare override (hcusd). Present (incl. 0) = active.
    const hcParam = resolveParam('hcusd', params.get('hcusd'));
    if (hcParam !== null && hcParam !== '' && !isNaN(parseInt(hcParam, 10))) {
      let n = parseInt(hcParam, 10);
      if (n < 0) n = 0; if (n > 5000) n = 5000;
      healthcareOverride = n;
      if (hcToggle) hcToggle.checked = true;
      if (hcField) hcField.classList.remove('hidden');
      if (hcInput) hcInput.value = String(n);
    }
    // Chips: rebuild once more now that savings/passive/hc are restored (they
    // land around the conf/horizon rebuild inside updateConfLabel above).
    updateAssumptionChips();

    // Restore filters from URL
    const countriesParam = params.get('countries');
    if (countriesParam) {
      const known = window.__paKnownCountries;
      countriesParam.split(',').forEach((raw) => {
        const c = decodeURIComponent(raw.trim());
        if (c && (!known || known.has(c))) selectedCountries.add(c);
      });
      if (typeof window.__paSyncRegion === 'function') window.__paSyncRegion();
    }
    if (params.get('climate')) filters.climate = params.get('climate');
    if (params.get('eng')) filters.eng = params.get('eng');
    if (params.get('hc')) filters.hc = params.get('hc');

    // Sync filter button styles
    for (const [key, val] of Object.entries(filters)) {
      document.querySelectorAll(`.filter-btn[data-filter="${key}"]`).forEach((btn) => {
        btn.classList.toggle('active', (btn.dataset.value || '') === val);
      });
    }

    // Restore lifestyle
    if (ls && ['budget', 'comfortable', 'luxury'].includes(ls)) {
      lifestyle = ls;
      // Sync hero buttons
      document.querySelectorAll('.lifestyle-btn').forEach((btn) => {
        const isActive = btn.dataset.lifestyle === lifestyle;
        btn.classList.toggle('bg-white/20', isActive);
        btn.classList.toggle('border-white/40', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('bg-white/5', !isActive);
        btn.classList.toggle('border-white/15', !isActive);
        btn.classList.toggle('text-white/70', !isActive);
      });
      syncResultsLifestyle();
    }

    // Restore optional inputs
    if (annualSavings > 0 && savingsInput) {
      savingsInput.value = annualSavings.toLocaleString('en-US');
    }
    if (passiveIncome > 0 && passiveInput) {
      passiveInput.value = passiveIncome.toLocaleString('en-US');
      // Show warning if > $1M
      if (passiveIncome > 1_000_000 && passiveWarn) {
        passiveWarn.textContent = "That's a large passive income \u2014 double-check this is an annual figure, not a total portfolio value.";
        passiveWarn.classList.remove('hidden');
      }
    }

    if (nw > 0) {
      portfolio = nw;
      portfolioInput.value = nw.toLocaleString('en-US');
      syncQuickButtons();
      renderResults();
    } else {
      fallbackSection?.classList.remove('hidden');
    }
  }

  // ─── Reverse Flow ───
  function setupReverseFlow() {
    const reverseLink = document.getElementById('reverse-link');
    const reverseFlow = document.getElementById('reverse-flow');
    const reverseClose = document.getElementById('reverse-close');
    const reverseInput = document.getElementById('reverse-city-input');
    const reverseDropdown = document.getElementById('reverse-city-dropdown');
    const reverseResults = document.getElementById('reverse-results');
    const reverseUse = document.getElementById('reverse-use-value');

    let selectedCity = null;
    let selectedTier = null;

    reverseLink?.addEventListener('click', (e) => {
      e.preventDefault();
      reverseFlow?.classList.remove('hidden');
      reverseFlow?.scrollIntoView({ behavior: 'smooth' });
    });

    reverseClose?.addEventListener('click', () => {
      reverseFlow?.classList.add('hidden');
    });

    // City search — matches header search behavior
    const reverseAlphabetical = [...cityData].sort((a, b) => a.name.localeCompare(b.name));
    let reverseHighlightIdx = -1;
    let reverseFiltered = [];

    function showReverseDropdown() {
      reverseDropdown?.classList.remove('hidden');
      reverseInput?.classList.add('search-input-open');
    }

    function hideReverseDropdown() {
      reverseDropdown?.classList.add('hidden');
      reverseInput?.classList.remove('search-input-open');
    }

    function renderReverseDropdown() {
      const q = reverseInput.value.toLowerCase().trim();
      reverseFiltered = (!q ? reverseAlphabetical : reverseAlphabetical.filter((c) =>
        c.name.toLowerCase().includes(q) || c.country.toLowerCase().includes(q)
      ));
      reverseHighlightIdx = -1;

      if (!reverseDropdown) return;
      if (reverseFiltered.length === 0) {
        reverseDropdown.innerHTML = '<div style="padding:0.75rem;text-align:center;font-size:0.875rem;color:#9ca3af;">No cities found</div>';
      } else {
        reverseDropdown.innerHTML = reverseFiltered.map((c, i) =>
          `<div class="search-item" data-slug="${c.slug}" data-idx="${i}">` +
            `<span>${c.emoji}</span>` +
            `<span class="search-city">${c.name}</span>` +
            `<span class="search-country">${c.country}</span>` +
          `</div>`
        ).join('');
        reverseDropdown.querySelectorAll('.search-item').forEach((item) => {
          item.addEventListener('mousedown', (e) => {
            e.preventDefault();
            selectedCity = cityData.find((c) => c.slug === item.dataset.slug);
            if (selectedCity) {
              reverseInput.value = selectedCity.name + ', ' + selectedCity.country;
              hideReverseDropdown();
              updateReverse();
            }
          });
          item.addEventListener('mouseover', () => {
            reverseHighlightIdx = parseInt(item.dataset.idx, 10);
            updateReverseHighlight();
          });
        });
      }
      showReverseDropdown();
    }

    function updateReverseHighlight() {
      const items = reverseDropdown.querySelectorAll('.search-item');
      for (let i = 0; i < items.length; i++) {
        if (i === reverseHighlightIdx) {
          items[i].classList.add('highlighted');
          items[i].scrollIntoView({ block: 'nearest' });
        } else {
          items[i].classList.remove('highlighted');
        }
      }
    }

    reverseInput?.addEventListener('input', renderReverseDropdown);
    reverseInput?.addEventListener('focus', renderReverseDropdown);

    reverseInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { hideReverseDropdown(); reverseInput.blur(); return; }
      if (reverseFiltered.length === 0) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (reverseHighlightIdx < reverseFiltered.length - 1) reverseHighlightIdx++;
        updateReverseHighlight();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (reverseHighlightIdx > 0) reverseHighlightIdx--;
        updateReverseHighlight();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const idx = reverseHighlightIdx >= 0 ? reverseHighlightIdx : 0;
        if (reverseFiltered[idx]) {
          selectedCity = reverseFiltered[idx];
          reverseInput.value = selectedCity.name + ', ' + selectedCity.country;
          hideReverseDropdown();
          updateReverse();
        }
      }
    });

    reverseInput?.addEventListener('blur', () => {
      setTimeout(() => hideReverseDropdown(), 200);
    });

    // Tier selection
    document.querySelectorAll('.reverse-tier-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedTier = btn.dataset.reverseTier;
        document.querySelectorAll('.reverse-tier-btn').forEach((b) => {
          b.classList.toggle('border-brand-500', b === btn);
          b.classList.toggle('bg-brand-50', b === btn);
          b.classList.toggle('border-sand-200', b !== btn);
        });
        updateReverse();
      });
    });

    // Backtest target for a tier's cost (the portfolio needed at the chosen
    // confidence over the chosen horizon). May be null if unreachable.
    // Passive income is netted out of spending, matching the forward map and
    // the city pages' "Needed to retire here" - the same city must show the
    // same target on every surface.
    function reverseTarget(monthlyCost) {
      if (!window.__paRequired) return null;
      return window.__paRequired({ annualSpending: Math.max(0, monthlyCost * 12 - passiveIncome), horizonYears, targetSurvival: threshold() });
    }

    function updateReverse() {
      if (!selectedCity || !selectedTier) return;
      const data = selectedCity.tiers[selectedTier];
      if (!data) return;

      const fireNumEl = document.getElementById('reverse-fire-number');
      const monthlyEl = document.getElementById('reverse-monthly');
      // Price with the same household/healthcare adjustments as the map, so
      // "Use this as my portfolio" can't contradict the forward verdict.
      const monthly = adjustedMonthlyOf(data);
      const target = reverseTarget(monthly);
      if (fireNumEl) fireNumEl.textContent = target != null ? fmtCompact(target) : '—';
      if (monthlyEl) monthlyEl.textContent = fmt(monthly);
      reverseResults?.classList.remove('hidden');
    }

    reverseUse?.addEventListener('click', () => {
      if (!selectedCity || !selectedTier) return;
      const tierData = selectedCity.tiers[selectedTier];
      if (!tierData) return;
      const mc = adjustedMonthlyOf(tierData);
      if (!mc) return;
      const target = reverseTarget(mc);
      if (target == null || target <= 0) return;
      portfolio = target;
      ssSet('portfolio', portfolio);
      portfolioInput.value = target.toLocaleString('en-US');
      reverseFlow?.classList.add('hidden');
      renderResults();
      resultsSection?.scrollIntoView({ behavior: 'smooth' });
    });
  }

  // ─── Share Button ───
  const shareBtn = document.getElementById('share-btn');
  const toast = document.getElementById('toast');
  shareBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(buildShareUrl()).then(() => {
      if (toast) {
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 2000);
      }
    });
  });

  // Back/forward cache: a bfcache-restored page resurrects with stale
  // in-memory state if a city page changed the household size or healthcare
  // override since — re-read the session and re-render. (Fresh loads re-run
  // restore(); the other inputs are only editable here, so they can't go stale.)
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    let changed = false;
    const sa = ssGet('adults');
    if (sa != null) {
      const next = sa === '2' ? 2 : 1;
      if (next !== adults) { adults = next; setAdultsActive(); changed = true; }
    }
    const sh = ssGet('hcusd');
    let nextHc = null;
    if (sh != null && sh !== '' && !isNaN(parseInt(sh, 10))) {
      nextHc = Math.max(0, Math.min(5000, parseInt(sh, 10)));
    }
    if (nextHc !== healthcareOverride) {
      healthcareOverride = nextHc;
      if (hcToggle) hcToggle.checked = nextHc != null;
      hcField?.classList.toggle('hidden', nextHc == null);
      if (hcInput) hcInput.value = nextHc == null ? '' : String(nextHc);
      changed = true;
    }
    if (!changed) return;
    updateAssumptionChips();
    if (portfolio > 0) { resetSectionCounts(); renderResults(); }
    else updateURL();
  });

  // ─── Init ───
  setupReverseFlow();
  restore();
</script>
