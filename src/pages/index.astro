<!-- Engine bridge: a module CAN import the bundled backtest engine + bands and
     expose them to the define:vars calculator below (which cannot import). This
     bundles the historical dataset into the homepage path. -->
<script>
  import { runBacktest } from '../data/backtest';
  import { classifySurvival, requiredPortfolio } from '../data/retirementBands';
  import { adjustedLines, HEALTHCARE_LINE_INDEX } from '../data/household';
  (window as any).__paBacktest = runBacktest;
  (window as any).__paClassify = classifySurvival;
  (window as any).__paRequired = requiredPortfolio;
  (window as any).__paAdjustLines = adjustedLines;
  (window as any).__paHcLineIndex = HEALTHCARE_LINE_INDEX;
  window.dispatchEvent(new Event('pa:engine-ready'));
</script>

<script define:vars={{ cityData, REGION_ORDER }}>
  // ─── State ───
  let portfolio = 0;
  let lifestyle = 'comfortable';
  let annualSavings = 0;
  let passiveIncome = 0;
  let horizonYears = 30;
  // ONE confidence threshold (from the confidence-level control / ?conf) drives
  // BOTH the green "you can retire here" cutoff AND the dollar target everywhere.
  const CONF_THRESHOLDS = { 80: 0.80, 90: 0.90, 95: 0.95 };
  let confPct = 90;
  function threshold() { return CONF_THRESHOLDS[confPct] || 0.90; }

  // Healthcare override: null = use our estimate; a number (>=0) replaces the
  // healthcare line at EVERY tier with that flat figure (VA/TriCare = 0).
  let healthcareOverride = null;
  function hcToken() { return healthcareOverride == null ? 'off' : 'h' + healthcareOverride; }

  // Household size: 1 (default — the stored single-adult basis, untouched) or
  // 2 adults (per-line scaling via the shared window.__paAdjustLines bridge).
  let adults = 1;
  function adultsToken() { return 'a' + adults; }

  // ─── Session-sticky personal inputs ───
  // The user's numbers (portfolio, passive, save, conf, horizon, tier, hcusd,
  // adults) follow them across pages for THIS tab session only (sessionStorage
  // — deliberately NOT localStorage: closing the tab still gives the next
  // visit a clean slate). On this page a URL param wins and updates the
  // session — the homepage is the entry point, so shared links and the
  // retire-on presets are intentional input. When the URL is silent, the
  // session value applies. City pages use the reverse precedence (session
  // wins) because their URLs can be stale after back-navigation. The header
  // ✕ badge clears every pa:* key.
  function ssGet(key) {
    try { return sessionStorage.getItem('pa:' + key); } catch (e) { return null; }
  }
  function ssSet(key, val) {
    try {
      if (val == null) sessionStorage.removeItem('pa:' + key);
      else sessionStorage.setItem('pa:' + key, String(val));
    } catch (e) { /* private mode */ }
  }
  // URL-first resolve for restore(): a present URL param wins + is stored;
  // otherwise fall back to the session.
  function resolveParam(key, urlVal) {
    if (urlVal != null && urlVal !== '') { ssSet(key, urlVal); return urlVal; }
    return ssGet(key);
  }

  // Adjusted monthly cost for one serialized tier ({monthlyCost, healthcare,
  // lines}). Order of operations: household scaling first (per line item),
  // THEN the healthcare override — the user's stated healthcare cost is
  // authoritative and is NOT multiplied; it replaces the (scaled) healthcare
  // line. Floor = the non-healthcare lines (override can remove healthcare
  // entirely but never drive the total negative).
  function adjustedMonthlyOf(t) {
    if (adults > 1 && window.__paAdjustLines) {
      // t.lines order (household.ts LINE ORDER): [housing, dining, groceries,
      // healthcare, transportation, entertainment, utilities, domesticHelp?,
      // luxuryExtras?]. __paHcLineIndex = the healthcare slot.
      const scaled = window.__paAdjustLines(t.lines, adults);
      const total = scaled.reduce((sum, n) => sum + n, 0);
      if (healthcareOverride == null) return total;
      return (total - scaled[window.__paHcLineIndex]) + Math.max(0, healthcareOverride);
    }
    // Single adult: exactly the pre-household code path.
    if (healthcareOverride == null) return t.monthlyCost;
    const remaining = t.monthlyCost - (t.healthcare || 0);
    return remaining + Math.max(0, healthcareOverride);
  }

  // Monthly cost for a city's selected tier.
  function adjustedMonthly(city) {
    return adjustedMonthlyOf(city.tiers[lifestyle]);
  }

  // Net annual withdrawal for a city's selected tier (gross cost minus passive).
  function netSpend(city) {
    return Math.max(0, adjustedMonthly(city) * 12 - passiveIncome);
  }

  // ─── Verdict engine: historical-backtest survival (the SAME engine the city
  //     pages use). Green iff survival >= the chosen threshold. ───
  const survivalCache = new Map(); // slug|tier|portfolio|horizon -> successRate (0..1 or null)
  let lastSurvivalKey = '';        // (portfolio|tier|horizon) the cache is warm for
  function citySurvival(city) {
    if (!window.__paBacktest) return undefined; // engine bundle not ready yet
    const key = city.slug + '|' + lifestyle + '|' + portfolio + '|' + horizonYears + '|' + passiveIncome + '|' + hcToken() + '|' + adultsToken();
    if (survivalCache.has(key)) return survivalCache.get(key);
    const s = window.__paBacktest({ initialPortfolio: portfolio, annualSpending: netSpend(city), horizonYears }).successRate;
    survivalCache.set(key, s);
    return s;
  }

  // Backtest-based "what you'd need": the portfolio that reaches the chosen
  // threshold for this tier's spend + horizon. Same threshold as the green cutoff,
  // so the number and the verdict are consistent by construction. May be null
  // (spend too high for any portfolio at this horizon). Cached; only for rendered cards.
  const neededCache = new Map();
  function cityNeeded(city) {
    if (!window.__paRequired || !window.__paBacktest) return undefined;
    const key = city.slug + '|' + lifestyle + '|' + horizonYears + '|' + passiveIncome + '|' + confPct + '|' + hcToken() + '|' + adultsToken();
    if (neededCache.has(key)) return neededCache.get(key);
    const n = window.__paRequired({ annualSpending: netSpend(city), horizonYears, targetSurvival: threshold() });
    neededCache.set(key, n);
    return n;
  }
  const INITIAL_PER_SECTION = 8;
  const sectionVisibleCounts = { perfect_fit: INITIAL_PER_SECTION, within_reach: INITIAL_PER_SECTION, not_affordable: INITIAL_PER_SECTION };
  function resetSectionCounts() {
    sectionVisibleCounts.perfect_fit = INITIAL_PER_SECTION;
    sectionVisibleCounts.within_reach = INITIAL_PER_SECTION;
    sectionVisibleCounts.not_affordable = INITIAL_PER_SECTION;
  }
  const filters = { climate: '', eng: '', hc: '' };
  // Region/country filter — SINGLE SOURCE OF TRUTH (region fullness, header
  // tri-state, and chip collapse are all derived from this set). Empty = all cities.
  const selectedCountries = new Set();

  // Climate mappings. "Four seasons" is the display label for continental
  // cities (formerly labeled "Mild") — the Mild filter keeps matching them.
  const warmClimates = ['Tropical', 'Warm', 'Desert'];
  const mildClimates = ['Mediterranean', 'Mild', 'Four seasons'];

  // ─── Helpers ───
  function fmt(n) {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(n);
  }

  function fmtCompact(n) {
    if (n >= 1_000_000) {
      const m = n / 1_000_000;
      return '$' + m.toFixed(2).replace(/\.?0+$/, '') + 'M';
    }
    if (n >= 1_000) return '$' + Math.round(n / 1_000) + 'K';
    return fmt(n);
  }

  function fmtPortfolio(n) {
    if (n >= 1_000_000) {
      const m = n / 1_000_000;
      return '$' + (m % 1 === 0 ? m.toFixed(0) : m.toFixed(1)) + 'M';
    }
    return '$' + Math.round(n / 1_000) + 'K';
  }

  function formatWithCommas(val) {
    const num = val.replace(/[^0-9]/g, '');
    return num.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function getScoreClass(score) {
    if (score >= 7.5) return 'fire-score-high';
    if (score >= 5.5) return 'fire-score-mid';
    return 'fire-score-low';
  }

  function getTagColorClient(category, value) {
    switch (category) {
      case 'climate':
        if (['Tropical', 'Warm', 'Desert'].includes(value)) return 'bg-amber-50 text-amber-700';
        if (value === 'Mediterranean') return 'bg-sky-50 text-sky-700';
        return 'bg-slate-50 text-slate-600';
      case 'safety':
        if (value === 'Very safe') return 'bg-emerald-50 text-emerald-700';
        if (value === 'Safe') return 'bg-green-50 text-green-700';
        return 'bg-orange-50 text-orange-600';
      case 'english':
        if (value === 'Widely spoken') return 'bg-blue-50 text-blue-700';
        if (value === 'Common') return 'bg-indigo-50 text-indigo-600';
        return 'bg-gray-50 text-gray-500';
      case 'visa':
        if (value === 'Easy') return 'bg-emerald-50 text-emerald-700';
        if (value === 'Moderate') return 'bg-amber-50 text-amber-700';
        return 'bg-red-50 text-red-600';
      default: return 'bg-gray-50 text-gray-600';
    }
  }

  // ─── DOM ───
  const portfolioInput = document.getElementById('portfolio-input');
  const exploreBtn = document.getElementById('explore-btn');
  const resultsSection = document.getElementById('results-section');
  const fallbackSection = document.getElementById('fallback-section');
  const citySections = document.getElementById('city-sections');
  const noCities = document.getElementById('no-cities');
  const summaryEl = document.getElementById('results-summary');

  // ─── Optional Toggle ───
  const optionalToggle = document.getElementById('optional-toggle');
  const optionalInputs = document.getElementById('optional-inputs');
  const optionalChevron = document.getElementById('optional-chevron');

  function setOptionalOpen(open) {
    if (!optionalInputs || !optionalChevron) return;
    optionalToggle?.setAttribute('aria-expanded', String(open));
    if (open) {
      optionalInputs.classList.remove('hidden');
      optionalChevron.style.transform = 'rotate(180deg)';
    } else {
      optionalInputs.classList.add('hidden');
      optionalChevron.style.transform = '';
    }
  }

  optionalToggle?.addEventListener('click', () => {
    const isHidden = optionalInputs?.classList.contains('hidden');
    setOptionalOpen(isHidden);
    if (isHidden && typeof gtag === 'function') gtag('event', 'assumptions_opened');
  });

  // ─── Assumption chips (collapsed-state summary of the live settings) ───
  const assumptionChips = document.getElementById('assumption-chips');
  const CHIP_CLASS = 'px-2.5 py-1 text-[11px] font-medium rounded-full bg-white/10 border border-white/15 text-sand-200';
  const CONF_CHIP_LABELS = { 80: 'Aggressive · 80%', 90: 'Balanced · 90%', 95: 'Conservative · 95%' };
  function updateAssumptionChips() {
    if (!assumptionChips) return;
    const labels = [
      CONF_CHIP_LABELS[confPct] || (confPct + '%'),
      horizonYears + ' years',
      adults === 2 ? 'Two adults' : 'Just me',
    ];
    if (annualSavings > 0) labels.push('Saving $' + annualSavings.toLocaleString('en-US') + '/yr');
    if (passiveIncome > 0) labels.push('$' + passiveIncome.toLocaleString('en-US') + '/yr passive');
    if (healthcareOverride != null) labels.push('Healthcare $' + healthcareOverride.toLocaleString('en-US') + '/mo');
    assumptionChips.replaceChildren(...labels.map((text) => {
      const chip = document.createElement('span');
      chip.className = CHIP_CLASS;
      chip.textContent = text;
      return chip;
    }));
  }

  // ─── Input Formatting ───
  portfolioInput.addEventListener('input', () => {
    const pos = portfolioInput.selectionStart || 0;
    const digitsBefore = portfolioInput.value.slice(0, pos).replace(/[^0-9]/g, '').length;
    portfolioInput.value = formatWithCommas(portfolioInput.value);
    let newPos = 0;
    let counted = 0;
    for (let i = 0; i < portfolioInput.value.length && counted < digitsBefore; i++) {
      if (/[0-9]/.test(portfolioInput.value[i])) counted++;
      newPos = i + 1;
    }
    portfolioInput.setSelectionRange(newPos, newPos);
    syncQuickButtons();
  });

  // ─── Optional Input Formatting & Validation ───
  const savingsInput = document.getElementById('savings-input');
  const passiveInput = document.getElementById('passive-input');
  const savingsError = document.getElementById('savings-error');
  const passiveError = document.getElementById('passive-error');
  const passiveWarn = document.getElementById('passive-warn');

  function setupOptionalInput(input, errorEl, onChange) {
    if (!input) return;
    input.addEventListener('input', () => {
      // Clear validation on typing
      if (errorEl) errorEl.classList.add('hidden');
      const raw = input.value;
      // Check for negative sign before stripping
      if (raw.includes('-')) {
        if (errorEl) { errorEl.textContent = 'Please enter a positive number'; errorEl.classList.remove('hidden'); }
        input.value = raw.replace(/-/g, '');
        return;
      }
      // Check for non-numeric (letters etc) before stripping
      if (raw.replace(/[,\s$]/g, '').length > 0 && !/[0-9]/.test(raw)) {
        if (errorEl) { errorEl.textContent = 'Please enter a number'; errorEl.classList.remove('hidden'); }
      }
      const pos = input.selectionStart || 0;
      const digitsBefore = input.value.slice(0, pos).replace(/[^0-9]/g, '').length;
      input.value = formatWithCommas(input.value);
      let newPos = 0;
      let counted = 0;
      for (let i = 0; i < input.value.length && counted < digitsBefore; i++) {
        if (/[0-9]/.test(input.value[i])) counted++;
        newPos = i + 1;
      }
      input.setSelectionRange(newPos, newPos);
    });
    input.addEventListener('change', () => {
      const val = parseInt((input.value || '').replace(/[^0-9]/g, ''), 10) || 0;
      onChange(val);
      if (portfolio > 0) { resetSectionCounts(); renderResults(); }
    });
  }

  setupOptionalInput(savingsInput, savingsError, (val) => { annualSavings = val; ssSet('save', val || null); updateAssumptionChips(); });
  setupOptionalInput(passiveInput, passiveError, (val) => {
    passiveIncome = val;
    ssSet('passive', val || null);
    updateAssumptionChips();
    // Warn if > $1M
    if (passiveWarn) {
      if (val > 1_000_000) {
        passiveWarn.textContent = "That's a large passive income \u2014 double-check this is an annual figure, not a total portfolio value.";
        passiveWarn.classList.remove('hidden');
      } else {
        passiveWarn.classList.add('hidden');
      }
    }
  });

  // \u2500\u2500\u2500 Confidence-level control & retirement-length slider \u2500\u2500\u2500
  const confValue = document.getElementById('conf-value');
  const horizonInput = document.getElementById('horizon-input');
  const horizonValue = document.getElementById('horizon-value');

  const CONF_LABELS = { 80: 'Aggressive (80%)', 90: 'Balanced (90%)', 95: 'Conservative (95%)' };
  function updateConfLabel() {
    if (confValue) confValue.textContent = CONF_LABELS[confPct] || ('' + confPct + '%');
    updateAssumptionChips();
  }
  function setConfActive() {
    document.querySelectorAll('.conf-stop').forEach((b) => {
      const active = parseInt(b.getAttribute('data-conf'), 10) === confPct;
      b.classList.toggle('bg-white/20', active);
      b.classList.toggle('border-white/40', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('bg-white/5', !active);
      b.classList.toggle('border-white/15', !active);
      b.classList.toggle('text-white/70', !active);
    });
  }
  document.querySelectorAll('.conf-stop').forEach((btn) => {
    btn.addEventListener('click', () => {
      confPct = parseInt(btn.getAttribute('data-conf'), 10) || 90;
      ssSet('conf', confPct);
      updateConfLabel();
      setConfActive();
      // The threshold gates the verdict AND sizes the target \u2014 re-render. Survival
      // is threshold-independent (cache stays warm); only the cutoff + target move.
      if (portfolio > 0) { resetSectionCounts(); renderResults(); }
    });
  });

  function updateHorizonLabel() {
    if (horizonValue) horizonValue.textContent = horizonYears + ' years';
    updateAssumptionChips();
  }
  let horizonDebounce;
  horizonInput?.addEventListener('input', () => {
    horizonYears = parseInt(horizonInput.value, 10) || 30;
    ssSet('horizon', horizonYears);
    updateHorizonLabel();
    // Horizon now drives the verdict — recompute the map (debounced so dragging
    // the slider doesn't re-run 112 backtests on every tick).
    if (portfolio > 0) {
      clearTimeout(horizonDebounce);
      horizonDebounce = setTimeout(() => { resetSectionCounts(); renderResults(); }, 150);
    }
  });

  // ─── Healthcare cost override ───
  const hcToggle = document.getElementById('hc-override-toggle');
  const hcField = document.getElementById('hc-override-field');
  const hcInput = document.getElementById('hc-override-input');
  let hcDebounce;
  // Read the input into healthcareOverride (null when toggle off / blank).
  function readHcOverride() {
    if (!hcToggle || !hcToggle.checked) { healthcareOverride = null; return; }
    const raw = (hcInput?.value || '').trim();
    if (raw === '') { healthcareOverride = null; return; }
    let n = parseInt(raw, 10);
    if (isNaN(n) || n < 0) n = 0;
    if (n > 5000) n = 5000;
    healthcareOverride = n;
  }
  function rerenderForHc() {
    readHcOverride();
    ssSet('hcusd', healthcareOverride);
    updateAssumptionChips();
    if (portfolio > 0) {
      clearTimeout(hcDebounce);
