---
import Layout from '../layouts/Layout.astro';
import SubscribeCTA from '../components/SubscribeCTA.astro';
import { allCities } from '../data/cities/index';
import { formatCurrency, getTotalSpend, REGION_ORDER } from '../data/types';
import { tierLines } from '../data/household';
import {
  getCityFireNumber,
  getLifestyleMonthlyCost,
  formatFireNumber,
  getCityDisplayTags,
  getTagColor,
  LIFESTYLE_LABELS,
  LIFESTYLE_DESCRIPTIONS,
  ALL_LIFESTYLE_TIERS,
  LIFESTYLE_TIER_MAP,
  PREMIUM_UNLOCK_THRESHOLDS,
} from '../data/fireNumber';
import type { LifestyleTier } from '../data/fireNumber';

// Pre-compute city data for client-side use
const cityData = allCities.map((city) => {
  const tags = getCityDisplayTags(city);
  const tiers: Record<string, { fireNumber: number; monthlyCost: number; healthcare: number; lines: number[] }> = {};
  for (const lifestyle of ALL_LIFESTYLE_TIERS) {
    tiers[lifestyle] = {
      fireNumber: getCityFireNumber(city, lifestyle),
      monthlyCost: getLifestyleMonthlyCost(city, lifestyle),
      // Baked healthcare line for this tier (for the client-side healthcare override).
      healthcare: city.tiers[LIFESTYLE_TIER_MAP[lifestyle]].healthcare.monthlyCost,
      // Per-line costs in household.ts LINE ORDER (for household-size scaling):
      // [housing, dining, groceries, healthcare, transportation, entertainment,
      //  utilities, domesticHelp?, luxuryExtras?]. Sum === monthlyCost.
      lines: tierLines(city.tiers[LIFESTYLE_TIER_MAP[lifestyle]]),
    };
  }
  return {
    name: city.name,
    country: city.country,
    slug: city.slug,
    emoji: city.emoji,
    region: city.region,
    fireScore: city.fireScore,
    tags,
    tiers,
    unlockThreshold: PREMIUM_UNLOCK_THRESHOLDS[city.slug] || 0,
  };
});


const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'PortfolioAtlas',
  'url': 'https://portfolioatlas.org',
  'description': `Enter your portfolio value and see where in the world you can retire across ${allCities.length} cities. Built on the 4% rule.`,
};

const calcLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': 'FIRE Retirement Calculator',
  'url': 'https://portfolioatlas.org',
  'applicationCategory': 'FinanceApplication',
  'operatingSystem': 'Web',
  'description': `Enter your portfolio and see where you can retire across ${allCities.length} cities worldwide.`,
  'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
};

const lifestyleLabels = LIFESTYLE_LABELS;
const lifestyleDescriptions = LIFESTYLE_DESCRIPTIONS;
---

<Layout
  title="Where Can Your Portfolio Buy You Freedom?"
  description={`See where in the world your portfolio can fund your retirement. ${allCities.length} cities, real FIRE numbers, and component-level cost-of-living breakdowns.`}
  jsonLd={[websiteLd, calcLd]}
>
  <!-- Hero -->
  <section class="bg-brand-950 text-white py-16 md:py-24">
    <div class="container-narrow text-center">
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
        Where Can You Retire?
      </h1>
      <p class="text-xl text-sand-300 max-w-2xl mx-auto mb-12">
        Enter your portfolio. See where in the world you can retire. Understand what that life looks like.
      </p>

      <!-- 1-2-3 Flow Indicator -->
      <div class="max-w-2xl mx-auto mb-12">
        <!-- Desktop -->
        <div class="hidden sm:flex items-start justify-center">
          <div class="flex flex-col items-center w-36">
            <div class="step-circle w-14 h-14 rounded-full bg-brand-600/20 ring-2 ring-brand-400/50 flex items-center justify-center text-xl font-bold text-white">1</div>
            <span class="text-xs font-medium text-sand-300 mt-2.5">Enter your portfolio</span>
          </div>
          <div class="flex-shrink-0 mt-7 w-12 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-400/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </div>
          <div class="flex flex-col items-center w-36">
            <div class="step-circle w-14 h-14 rounded-full bg-brand-600/20 ring-2 ring-brand-400/50 flex items-center justify-center text-xl font-bold text-white">2</div>
            <span class="text-xs font-medium text-sand-300 mt-2.5">Choose your lifestyle</span>
          </div>
          <div class="flex-shrink-0 mt-7 w-12 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-400/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </div>
          <div class="flex flex-col items-center w-36">
            <div class="step-circle w-14 h-14 rounded-full bg-brand-600/20 ring-2 ring-brand-400/50 flex items-center justify-center text-xl font-bold text-white">3</div>
            <span class="text-xs font-medium text-sand-300 mt-2.5">Explore results</span>
          </div>
        </div>
        <!-- Mobile -->
        <div class="sm:hidden flex flex-col items-center gap-1.5">
          <div class="flex items-center gap-3 w-56">
            <div class="step-circle w-11 h-11 shrink-0 rounded-full bg-brand-600/20 ring-2 ring-brand-400/50 flex items-center justify-center text-base font-bold text-white">1</div>
            <span class="text-sm font-medium text-sand-300">Enter your portfolio</span>
          </div>
          <svg class="w-4 h-4 text-brand-400/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" /></svg>
          <div class="flex items-center gap-3 w-56">
            <div class="step-circle w-11 h-11 shrink-0 rounded-full bg-brand-600/20 ring-2 ring-brand-400/50 flex items-center justify-center text-base font-bold text-white">2</div>
            <span class="text-sm font-medium text-sand-300">Choose your lifestyle</span>
          </div>
          <svg class="w-4 h-4 text-brand-400/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" /></svg>
          <div class="flex items-center gap-3 w-56">
            <div class="step-circle w-11 h-11 shrink-0 rounded-full bg-brand-600/20 ring-2 ring-brand-400/50 flex items-center justify-center text-base font-bold text-white">3</div>
            <span class="text-sm font-medium text-sand-300">Explore results</span>
          </div>
        </div>
      </div>

      <div class="max-w-xl mx-auto">
        <!-- Input 1: Portfolio Value -->
        <div class="mb-8">
          <label for="portfolio-input" class="block text-lg font-semibold text-white mb-3">
            Your Portfolio Value
          </label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-300 text-xl font-bold">$</span>
            <input
              type="text"
              id="portfolio-input"
              inputmode="numeric"
              placeholder="2,500,000"
              autocomplete="off"
              class="w-full pl-10 pr-4 py-4 text-2xl font-bold rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-brand-400"
            />
          </div>
          <div class="flex flex-wrap justify-center gap-2 mt-3">
            {[500_000, 1_000_000, 2_000_000, 3_000_000, 5_000_000, 10_000_000].map((value) => (
              <button
                type="button"
                class="quick-btn px-4 py-1.5 text-sm font-medium rounded-full bg-white/10 border border-white/20 text-white/80 hover:bg-white/20 hover:text-white transition-all"
                data-value={value}
              >
                {value >= 1_000_000 ? `$${value / 1_000_000}M` : `$${value / 1_000}K`}
              </button>
            ))}
          </div>
        </div>

        <!-- Input 2: Lifestyle Selector -->
        <div class="mb-8">
          <label class="block text-lg font-semibold text-white mb-3">
            Your Lifestyle
          </label>
          <div class="grid grid-cols-3 gap-2">
            {ALL_LIFESTYLE_TIERS.map((tier) => (
              <button
                type="button"
                class:list={[
                  'lifestyle-btn px-4 py-3 rounded-xl border text-center transition-all',
                  tier === 'comfortable'
                    ? 'bg-white/20 border-white/40 text-white'
                    : 'bg-white/5 border-white/15 text-white/70 hover:bg-white/10 hover:text-white',
                ]}
                data-lifestyle={tier}
              >
                <div class="text-sm font-bold">{lifestyleLabels[tier]}</div>
                <div class="text-[11px] mt-1 opacity-70">{lifestyleDescriptions[tier]}</div>
              </button>
            ))}
          </div>
        </div>

        <!-- Input 3: Assumptions (collapsed by default; chips mirror the live settings) -->
        <div class="mb-8">
          <button
            type="button"
            id="optional-toggle"
            aria-expanded="false"
            aria-controls="optional-inputs"
            class="w-full px-4 py-3 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 hover:border-white/30 text-left transition-all"
          >
            <span class="flex items-center justify-between gap-2">
              <span class="text-sm font-semibold text-white">Your assumptions</span>
              <svg id="optional-chevron" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sand-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
            <span id="assumption-chips" class="flex flex-wrap gap-1.5 mt-2">
              <span class="px-2.5 py-1 text-[11px] font-medium rounded-full bg-white/10 border border-white/15 text-sand-200">Balanced · 90%</span>
              <span class="px-2.5 py-1 text-[11px] font-medium rounded-full bg-white/10 border border-white/15 text-sand-200">30 years</span>
              <span class="px-2.5 py-1 text-[11px] font-medium rounded-full bg-white/10 border border-white/15 text-sand-200">Just me</span>
            </span>
          </button>

          <div id="optional-inputs" class="hidden mt-4 pt-4 border-t border-white/10 space-y-4">
            <!-- Annual Savings from Work -->
            <div>
              <label for="savings-input" class="block text-xs font-medium text-sand-300 mb-1.5">
                Annual savings from work (optional)
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-brand-300 text-sm font-bold">$</span>
                <input
                  type="text"
                  id="savings-input"
                  inputmode="numeric"
                  placeholder="e.g. $30,000/year from your salary"
                  autocomplete="off"
                  class="w-full pl-8 pr-3 py-2.5 text-sm font-bold rounded-lg bg-white/10 backdrop-blur-sm border border-white/15 text-white placeholder-white/25 focus:outline-none focus:ring-2 focus:ring-brand-400"
                />
              </div>
              <p id="savings-error" class="text-xs text-red-400 mt-1 hidden"></p>
              <p class="text-[11px] text-sand-500 mt-1.5 leading-snug">How much you save each year from working. We'll use this to show when cities become affordable as your portfolio grows.</p>
            </div>

            <!-- Passive Income in Retirement -->
            <div>
              <label for="passive-input" class="block text-xs font-medium text-sand-300 mb-1.5">
                Passive income in retirement (optional)
                <span class="relative group inline-block ml-1 cursor-help align-middle">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sand-400 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 rounded-lg bg-brand-950 text-white text-[11px] leading-snug px-3 py-2 shadow-lg opacity-0 group-hover:opacity-100 transition-opacity z-50">
                    Assumes this income continues indefinitely and keeps pace with inflation. Fixed income sources like pensions may provide less protection over time.
                  </span>
                </span>
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-brand-300 text-sm font-bold">$</span>
                <input
                  type="text"
                  id="passive-input"
                  inputmode="numeric"
                  placeholder="e.g. $24,000/year from rental income"
                  autocomplete="off"
                  class="w-full pl-8 pr-3 py-2.5 text-sm font-bold rounded-lg bg-white/10 backdrop-blur-sm border border-white/15 text-white placeholder-white/25 focus:outline-none focus:ring-2 focus:ring-brand-400"
                />
              </div>
              <p id="passive-error" class="text-xs text-red-400 mt-1 hidden"></p>
              <p id="passive-warn" class="text-xs text-amber-400 mt-1 hidden"></p>
              <p class="text-[11px] text-sand-500 mt-1.5 leading-snug">Rental income, dividends, pension, or any income that continues after you stop working. Reduces the portfolio you need to retire.</p>
            </div>

            <!-- Confidence level (the single threshold: drives the verdict AND the target) -->
            <div>
              <label class="block text-xs font-medium text-sand-300 mb-1.5">
                Confidence level: <span id="conf-value" class="font-bold text-white">Balanced (90%)</span>
              </label>
              <div id="conf-stops" class="grid grid-cols-3 gap-1.5">
                <button type="button" data-conf="80" class="conf-stop py-2 text-[11px] font-semibold rounded-lg border border-white/15 bg-white/5 text-white/70 transition-all">Aggressive<br><span class="text-[10px] opacity-70">80%</span></button>
                <button type="button" data-conf="90" class="conf-stop py-2 text-[11px] font-semibold rounded-lg border border-white/15 bg-white/5 text-white/70 transition-all">Balanced<br><span class="text-[10px] opacity-70">90%</span></button>
                <button type="button" data-conf="95" class="conf-stop py-2 text-[11px] font-semibold rounded-lg border border-white/15 bg-white/5 text-white/70 transition-all">Conservative<br><span class="text-[10px] opacity-70">95%</span></button>
              </div>
              <p class="text-[11px] text-sand-500 mt-1.5 leading-snug">How sure you want to be, based on market history. Higher = stricter "you can retire here" and a larger target.</p>
            </div>

            <!-- Retirement length (drives the per-city backtest only) -->
            <div>
              <label for="horizon-input" class="block text-xs font-medium text-sand-300 mb-1.5">
                Retirement length: <span id="horizon-value" class="font-bold text-white">30 years</span>
              </label>
              <input
                type="range"
                id="horizon-input"
                min="20"
                max="60"
                step="5"
                value="30"
                class="w-full accent-brand-500 cursor-pointer"
              />
              <p class="text-[11px] text-sand-500 mt-1.5 leading-snug">Drives the verdict: your plan is backtested over every period this long in market history. Early retirees often plan 40–50+.</p>
            </div>

            <!-- Household size (scales costs per category from the single-adult basis) -->
            <div>
              <label class="block text-xs font-medium text-sand-300 mb-1.5">
                Household size
              </label>
              <div id="adults-stops" class="grid grid-cols-2 gap-1.5">
                <button type="button" data-adults="1" class="adults-stop py-2 text-[11px] font-semibold rounded-lg border border-white/15 bg-white/5 text-white/70 transition-all">Just me</button>
                <button type="button" data-adults="2" class="adults-stop py-2 text-[11px] font-semibold rounded-lg border border-white/15 bg-white/5 text-white/70 transition-all">Two adults</button>
              </div>
              <p class="text-[11px] text-sand-500 mt-1.5 leading-snug">Costs scale by category, not a flat multiple — housing is largely shared; food and healthcare scale per person.</p>
            </div>

            <!-- Healthcare cost override (flat across all tiers) -->
            <div>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="hc-override-toggle" class="w-4 h-4 accent-brand-500" />
                <span class="text-xs font-medium text-sand-300">Use my own healthcare cost</span>
              </label>
              <div id="hc-override-field" class="hidden mt-2">
                <label for="hc-override-input" class="block text-[11px] text-sand-400 mb-1">My healthcare cost (monthly, USD)</label>
                <input
                  type="number"
                  id="hc-override-input"
                  min="0"
                  max="5000"
                  step="50"
                  inputmode="numeric"
                  placeholder="e.g. 1100, or 0 for VA/TriCare"
                  class="w-full px-3 py-2 text-sm rounded-lg border border-white/15 bg-white/5 text-white placeholder-white/30 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 focus:outline-none"
                />
                <p class="text-[11px] text-sand-500 mt-1.5 leading-snug">Enter your real monthly healthcare cost and we'll use it across all lifestyle tiers — handy for VA/TriCare (enter 0) or when your ACA cost differs from our estimate.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA (Step 3) -->
        <button
          type="button"
          id="explore-btn"
          class="w-full py-4 text-lg font-bold rounded-xl bg-brand-600 text-white hover:bg-brand-700 transition-colors"
        >
          Explore Where I Can Retire →
        </button>

        <p class="mt-4 text-sm text-sand-400">
          <a href="#reverse-flow" id="reverse-link" class="hover:text-white transition-colors underline decoration-dotted underline-offset-4">
            Not sure of your number? Calculate what you need →
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Results Section (hidden until portfolio is entered) -->
  <section id="results-section" class="hidden scroll-mt-16">
    <!-- Summary line -->
    <div class="bg-white border-b border-sand-200 sticky top-16 z-30">
      <div class="container-narrow py-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center gap-3">
            <p id="results-summary" class="text-lg font-serif font-bold text-brand-950"></p>
            <button id="share-btn" type="button" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border border-sand-200 text-gray-600 hover:bg-sand-50 hover:border-brand-300 transition-all" title="Copy shareable link">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
              Share
            </button>
          </div>
          <!-- Inline lifestyle toggle for results page -->
          <div class="flex items-center gap-1">
            {ALL_LIFESTYLE_TIERS.map((tier) => (
              <button
                type="button"
                class:list={[
                  'results-lifestyle-btn px-3 py-1.5 text-xs font-semibold rounded-full border transition-all',
                  tier === 'comfortable'
                    ? 'bg-brand-600 text-white border-brand-600'
                    : 'bg-white text-gray-600 border-sand-200 hover:border-brand-300',
                ]}
                data-lifestyle={tier}
              >
                {lifestyleLabels[tier]}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Filters -->
    <div class="container-narrow py-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Filter:</span>
        <!-- Region / country multi-select (replaces the old US/International toggle) -->
        <div class="relative" id="region-filter">
          <button type="button" id="region-trigger" class="filter-btn px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all inline-flex items-center gap-1.5" aria-haspopup="true" aria-expanded="false">
            <span id="region-trigger-label">All regions</span>
            <svg class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div id="region-panel" class="hidden absolute left-0 top-full mt-1 z-40 w-72 max-w-[calc(100vw-2rem)] max-h-80 overflow-y-auto bg-white border border-sand-200 rounded-xl shadow-lg p-3">
            <input id="region-search" type="text" placeholder="Search regions or countries…" autocomplete="off" class="w-full mb-2 px-3 py-1.5 text-sm rounded-lg border border-sand-200 bg-sand-50 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 focus:outline-none" />
            <div id="region-tree"></div>
          </div>
        </div>
        <div class="w-px h-5 bg-sand-200"></div>
        <div class="flex gap-1">
          <button data-filter="climate" data-value="" class="filter-btn active px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all">Any Climate</button>
          <button data-filter="climate" data-value="warm" class="filter-btn px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all">Warm</button>
          <button data-filter="climate" data-value="mild" class="filter-btn px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all">Mild</button>
        </div>
        <div class="w-px h-5 bg-sand-200"></div>
        <div class="flex gap-1">
          <button data-filter="eng" data-value="" class="filter-btn active px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all">Any Language</button>
          <button data-filter="eng" data-value="yes" class="filter-btn px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all">English Essential</button>
        </div>
        <div class="w-px h-5 bg-sand-200"></div>
        <div class="flex gap-1">
          <button data-filter="hc" data-value="" class="filter-btn active px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all">Any Healthcare</button>
          <button data-filter="hc" data-value="good" class="filter-btn px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all">Good+</button>
          <button data-filter="hc" data-value="excellent" class="filter-btn px-3 py-1.5 text-xs font-medium rounded-full border border-sand-200 transition-all">Excellent</button>
        </div>
      </div>
      <!-- Selected region/country chips -->
      <div id="region-chips" class="flex flex-wrap items-center gap-1.5 mt-2.5 empty:hidden"></div>
    </div>

    <!-- Methodology note (base note ↔ 2-adult indicator swap on household toggle) -->
    <div class="container-narrow pb-2">
      <p class="household-note hidden text-xs font-semibold text-brand-700 mb-1">Showing costs for 2 adults — housing largely shared; food and healthcare scaled per person.</p>
      <p class="text-xs text-gray-400 leading-snug">
        <span class="household-base-note">Cost estimates are for a one-person household — adjust household size under "Your assumptions". </span>"Needed to retire here" is the portfolio that survived your retirement length in a historical backtest at your chosen confidence; the 4% rule is shown elsewhere only as a familiar benchmark.
      </p>
    </div>

    <!-- City Sections -->
    <div class="container-wide pb-16">
      <div id="city-sections"></div>
      <div id="no-cities" class="hidden py-12 text-center">
        <p class="text-gray-500 font-semibold mb-2">No cities match your criteria</p>
        <p class="text-sm text-gray-400">Try adjusting your filters or increasing your portfolio.</p>
        <div class="mt-6">
          <SubscribeCTA
            variant="link"
            utm="no_results"
