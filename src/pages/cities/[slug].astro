---
import Layout from '../../layouts/Layout.astro';
import CityHero from '../../components/CityHero.astro';
import FireStatusCard from '../../components/FireStatusCard.astro';
import ComparisonCTA from '../../components/ComparisonCTA.astro';
import CityFAQ from '../../components/CityFAQ.astro';
import RelatedCities from '../../components/RelatedCities.astro';
import SubscribeCTA from '../../components/SubscribeCTA.astro';
import { allCities, getCityBySlug, getAllSlugs } from '../../data/cities/index';
import { formatCurrency, getTotalSpend } from '../../data/types';
import { tierLines } from '../../data/household';
import { DATA_RECENCY, getCityConfidenceLevel } from '../../data/spendingProfile';
import {
  getAllFireNumbers,
  formatFireNumber,
  getCityDisplayTags,
  getTagColor,
  LIFESTYLE_LABELS,
  ALL_LIFESTYLE_TIERS,
  LIFESTYLE_TIER_MAP,
} from '../../data/fireNumber';
import type { LifestyleTier } from '../../data/fireNumber';

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const city = getCityBySlug(slug!);

if (!city) {
  return Astro.redirect('/404');
}

const confidenceLevel = getCityConfidenceLevel(city.slug);
const fireNumbers = getAllFireNumbers(city);
const displayTags = getCityDisplayTags(city);

// JSON-LD structured data
const siteUrl = 'https://portfolioatlas.org';
const pageUrl = `${siteUrl}/cities/${city.slug}/`;

const tier1M = city.tiers['1M'];
const tier3M = city.tiers['3M'];
const totalSpend1M = getTotalSpend(tier1M);
const totalSpend3M = getTotalSpend(tier3M);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': siteUrl },
    { '@type': 'ListItem', 'position': 2, 'name': city.name, 'item': pageUrl },
  ],
};

const placeLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  'name': `${city.name}, ${city.country}`,
  'description': city.description,
  'url': pageUrl,
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': city.name,
    'addressCountry': city.country,
  },
};

const isDomestic = city.country === 'United States';

// Data strings concatenated into FAQ sentences don't always carry terminal
// punctuation — normalize before joining so seams like "dry winters The
// average temperature" can't occur.
function ensureSentence(text: string): string {
  const trimmed = text.trim();
  return /[.!?]$/.test(trimmed) ? trimmed : trimmed + '.';
}

// FAQ rating statements derive from displayTags — the SAME source the header
// badges use — so the two can never disagree. quickFacts.englishFriendly and
// quickFacts.safetyRating are intentionally not used here.
const englishFaqLead: Record<string, string> = {
  'Widely spoken': `English is widely spoken in ${city.name}.`,
  'Common': `English is commonly spoken in ${city.name}.`,
  'Limited': `English proficiency in ${city.name} is limited.`,
};
const safetyFaqLead: Record<string, string> = {
  'Very safe': `${city.name} is very safe for retirees`,
  'Safe': `${city.name} is generally safe for retirees`,
  'Exercise caution': `Retirees should exercise normal caution in ${city.name}`,
};

// The language field is sometimes a multi-value list ("English / Afrikaans /
// Xhosa") — render those as a proper Oxford-comma sentence instead of
// dumping the raw field after "The primary language is".
const languageList = city.quickFacts.language.split(/[/,]/).map((s) => s.trim()).filter(Boolean);
const languageSentence = languageList.length > 1
  ? `Languages spoken include ${languageList.slice(0, -1).join(', ')}${languageList.length > 2 ? ',' : ''} and ${languageList[languageList.length - 1]}.`
  : `The primary language is ${languageList[0]}.`;

const faqQuestions = [
  {
    question: `What is the FIRE Number for ${city.name}, ${city.country}?`,
    answer: `The FIRE Number for ${city.name} ranges from ${formatFireNumber(fireNumbers.budget.fireNumber)} (Lean FIRE lifestyle) to ${formatFireNumber(fireNumbers.luxury.fireNumber)} (Fat FIRE lifestyle). A FIRE retirement requires a portfolio of approximately ${formatFireNumber(fireNumbers.comfortable.fireNumber)}, based on estimated monthly costs of ${formatCurrency(fireNumbers.comfortable.monthlyCost)} and a 4% safe withdrawal rate.`,
  },
  {
    question: `How much does it cost to retire in ${city.name}?`,
    answer: `Monthly living costs in ${city.name} range from ${formatCurrency(totalSpend1M)} (Lean FIRE) to ${formatCurrency(totalSpend3M)} (FIRE), covering housing (market rent), dining, groceries, healthcare, transportation, entertainment, and utilities.`,
  },
  {
    question: `What is healthcare like in ${city.name} for ${isDomestic ? 'retirees' : 'expats and retirees'}?`,
    answer: `Healthcare in ${city.name} costs approximately ${formatCurrency(tier1M.healthcare.monthlyCost)} to ${formatCurrency(tier3M.healthcare.monthlyCost)}/month depending on coverage level. Typical coverage at the Lean FIRE budget: ${ensureSentence(tier1M.healthcare.description)}`,
  },
  ...(!isDomestic ? [{
    question: `Do I need a visa to retire in ${city.name}, ${city.country}?`,
    answer: ensureSentence(city.quickFacts.visa),
  }] : []),
  {
    question: `What is the weather like in ${city.name}?`,
    answer: `${ensureSentence(city.quickFacts.climate)} The average temperature is ${city.quickFacts.averageTemp}.`,
  },
  ...(!isDomestic ? [{
    question: `Is ${city.name} English-friendly?`,
    answer: `${englishFaqLead[displayTags.english]} ${languageSentence}`,
  }] : []),
  {
    question: `How safe is ${city.name} for retirees?`,
    answer: `${safetyFaqLead[displayTags.safety]}, scoring ${city.scores.safety} out of 10 in our safety ratings.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqQuestions.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer,
    },
  })),
};

const jsonLd = [breadcrumbLd, placeLd, faqLd];

// Pre-compute data for client-side portfolio comparison
const fireNumbersJSON = JSON.stringify(fireNumbers);
const lifestyleTierMapJSON = JSON.stringify(LIFESTYLE_TIER_MAP);

// Get lifestyle descriptions for the 3 tiers
const lifestyleDescriptions = ALL_LIFESTYLE_TIERS.map((tier) => ({
  tier,
  label: LIFESTYLE_LABELS[tier],
  description: city.tiers[LIFESTYLE_TIER_MAP[tier]].lifestyle,
}));

// All display tags as entries for iteration
const tagEntries = Object.entries(displayTags) as [string, string][];

// Country hub link
const countrySlug = city.country.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const countryHubUrl = `/retire-in/${countrySlug}/`;

// Portfolio tier link — find the smallest tier >= this city's FIRE number
const portfolioTiers = [
  { slug: '500k', label: '$500K', value: 500_000 },
  { slug: '750k', label: '$750K', value: 750_000 },
  { slug: '1m', label: '$1M', value: 1_000_000 },
  { slug: '1-5m', label: '$1.5M', value: 1_500_000 },
  { slug: '2m', label: '$2M', value: 2_000_000 },
  { slug: '3m', label: '$3M', value: 3_000_000 },
];
const cityFire = fireNumbers.comfortable.fireNumber;
const nearestTier = portfolioTiers.find((t) => t.value >= cityFire) || portfolioTiers[portfolioTiers.length - 1];
const portfolioTierUrl = `/retire-on/${nearestTier.slug}/`;

// SEO: title with length check (prefer full format, fallback to short if >70 chars)
const fullTitle = `${city.name} FIRE Number: How Much You Need to Retire in ${city.name}, ${city.country}`;
const shortTitle = `Retire in ${city.name}: FIRE Number & Cost`;
const pageTitle = fullTitle.length + ' | PortfolioAtlas'.length <= 70 ? fullTitle : shortTitle;

// SEO: meta description with all 3 tier FIRE Numbers (target 140-160 chars)
const metaDesc = `Retiring in ${city.name}? You need ${formatFireNumber(fireNumbers.comfortable.fireNumber)} invested (4% rule). See Lean FIRE (${formatFireNumber(fireNumbers.budget.fireNumber)}), FIRE (${formatFireNumber(fireNumbers.comfortable.fireNumber)}), and Fat FIRE (${formatFireNumber(fireNumbers.luxury.fireNumber)}) cost breakdowns for ${city.name}, ${city.country}.`;
---

<Layout
  title={pageTitle}
  description={metaDesc}
  jsonLd={jsonLd}
>
  <CityHero city={city} />

  <div class="container-narrow py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main content -->
      <div class="lg:col-span-2 space-y-10">

        <!-- 1. FIRE Numbers Table -->
        <section>
          <h2 class="font-serif text-3xl font-bold text-brand-950 mb-3">
            Lean FIRE, FIRE, and Fat FIRE for {city.name}
          </h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            <strong>Needed to retire here</strong> is the portfolio that, in a historical backtest,
            would have lasted your retirement at your chosen confidence and length.
            <strong>Status</strong> is the verdict for your portfolio. The 4% rule benchmark is shown
            underneath each figure for reference only.
            <span class="household-base-note text-sm text-gray-500">Cost estimates are for a one-person household — adjust household size below.</span>
          </p>

          <!-- Re-price controls: household size + healthcare override (both re-price the verdict) -->
          <div class="mb-6 bg-sand-50 border border-sand-200 rounded-xl p-4 space-y-4">
            <div>
              <span class="block text-sm font-medium text-brand-950 mb-1.5">Household size</span>
              <div class="flex items-center gap-1.5">
                <button type="button" data-adults="1" class="adults-btn px-3 py-1.5 text-xs font-semibold rounded-full border border-sand-200 text-gray-600 transition-all">Just me</button>
                <button type="button" data-adults="2" class="adults-btn px-3 py-1.5 text-xs font-semibold rounded-full border border-sand-200 text-gray-600 transition-all">Two adults</button>
              </div>
              <p class="text-[11px] text-gray-500 mt-1.5 leading-snug">Costs scale by category, not a flat multiple — housing is largely shared; food and healthcare scale per person.</p>
            </div>
            <div class="border-t border-sand-200 pt-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="hc-override-toggle" class="w-4 h-4 accent-brand-600" />
              <span class="text-sm font-medium text-brand-950">Use my own healthcare cost</span>
            </label>
            <div id="hc-override-field" class="hidden mt-2">
              <label for="hc-override-input" class="block text-xs text-gray-500 mb-1">My healthcare cost (monthly, USD)</label>
              <input type="number" id="hc-override-input" min="0" max="5000" step="50" inputmode="numeric"
                placeholder="e.g. 1100, or 0 for VA/TriCare"
                class="w-full sm:w-64 px-3 py-2 text-sm rounded-lg border border-sand-200 bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500 focus:outline-none" />
              <p class="text-[11px] text-gray-500 mt-1.5 leading-snug">Enter your real monthly healthcare cost and we'll use it across all lifestyle tiers — handy for VA/TriCare (enter 0) or when your ACA cost differs from our estimate.</p>
            </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-sand-200 shadow-sm overflow-hidden">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b-2 border-sand-200 bg-sand-50">
                  <th class="text-left py-3 px-5 font-semibold text-gray-600">Lifestyle</th>
                  <th class="text-right py-3 px-5 font-semibold text-gray-600">Needed to retire here</th>
                  <th class="text-right py-3 px-5 font-semibold text-gray-600">Monthly Cost</th>
                  <th class="text-right py-3 px-5 font-semibold text-gray-600 hidden sm:table-cell" id="status-header">Status</th>
                </tr>
              </thead>
              <tbody>
                {ALL_LIFESTYLE_TIERS.map((tier) => {
                  const data = fireNumbers[tier];
                  return (
                    <tr
                      class="border-b border-sand-100 fire-row"
                      data-tier={tier}
                      data-fire-number={data.fireNumber}
                      data-monthly-cost={data.monthlyCost}
                      data-healthcare={city.tiers[LIFESTYLE_TIER_MAP[tier]].healthcare.monthlyCost}
                      data-lines={JSON.stringify(tierLines(city.tiers[LIFESTYLE_TIER_MAP[tier]]))}
                    >
                      <td class="py-4 px-5">
                        <div class="font-bold text-brand-950">{LIFESTYLE_LABELS[tier]}</div>
                      </td>
                      <td class="text-right py-4 px-5">
                        <span class="text-lg font-bold text-brand-700">{formatFireNumber(data.fireNumber)}</span>
                      </td>
                      <td class="text-right py-4 px-5">
                        <span class="monthly-cost-val text-sm text-gray-600">{formatCurrency(data.monthlyCost)}/mo</span>
                        <div class="wd-rate text-[10px] text-gray-400 font-normal mt-0.5 hidden"></div>
                      </td>
                      <td class="text-right py-4 px-5 hidden sm:table-cell fire-status"></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <!-- Household-size indicator (state visibility when costs are scaled) -->
          <p class="household-note hidden mt-3 text-xs font-semibold text-brand-700">Showing costs for 2 adults — housing largely shared; food and healthcare scaled per person.</p>

          <!-- Passive income note (shown client-side when passive income adjusts values) -->
          <div id="passive-income-note" class="hidden mt-3 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2.5">
            <p id="passive-income-note-text" class="text-xs text-amber-800 font-medium"></p>
          </div>

          <div class="flex items-center gap-3 mt-3">
            <span class="text-xs text-gray-400">Cost data: {city.dataRecency ?? DATA_RECENCY}</span>
            <span class="text-xs text-gray-300">&middot;</span>
            <span class:list={[
              'text-xs font-medium',
              confidenceLevel === 'High' ? 'text-emerald-600' : confidenceLevel === 'Medium' ? 'text-amber-600' : 'text-gray-400',
            ]}>
              {confidenceLevel} confidence
            </span>
          </div>

          <!-- Portfolio prompt (shown when no portfolio set) -->
          <div id="portfolio-prompt" class="mt-4 bg-brand-50 border border-brand-200 rounded-xl px-5 py-4 text-center hidden">
            <p class="text-sm text-brand-800 font-medium mb-2">Enter your portfolio to see which tiers you can afford</p>
            <a href="/" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 text-white text-sm font-semibold rounded-lg hover:bg-brand-700 transition-colors">
              See Where I Can Retire
            </a>
          </div>
        </section>

        <!-- Personalized FIRE Status Card (shown client-side when portfolio is set) -->
        <FireStatusCard cityName={city.name} country={city.country} fireNumbers={fireNumbers} />

        <!-- 2. Lifestyle Descriptions -->
        <section>
          <h2 class="font-serif text-2xl font-bold text-brand-950 mb-2">
            Cost of Living Breakdown for {city.name}
          </h2>
          <p class="text-xs text-gray-400 mb-4"><span class="household-base-note">Cost and FIRE figures are for a one-person household — adjust household size in the controls above.</span><span class="household-note hidden font-semibold text-brand-700">Showing costs for 2 adults.</span></p>

          <div class="space-y-4">
            {lifestyleDescriptions.map(({ tier, label, description }) => (
              <div class="bg-white rounded-xl border border-sand-200 p-5 lifestyle-desc" data-tier={tier}>
                <div class="flex items-center justify-between mb-3">
                  <h3 class="font-serif text-lg font-bold text-brand-950">{label} Lifestyle</h3>
                  <span class="lifestyle-fire text-sm font-semibold text-brand-600">
                    {formatFireNumber(fireNumbers[tier].fireNumber)}
                  </span>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed">{description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- 3. Retirement Confidence -->
        <section id="confidence-section">
          <h2 class="font-serif text-2xl font-bold text-brand-950 mb-2">
            Retirement Confidence
          </h2>
          <p class="text-sm text-gray-500 mb-4">
            The 4% rule is a great starting point. Here we go a step further and test your plan against real market history.
          </p>
          <div id="confidence-result" class="bg-white rounded-xl border border-sand-200 p-5">
            <p id="confidence-text" class="text-gray-600">
              Enter your portfolio on the <a href="/" class="text-brand-600 hover:underline font-medium">homepage</a> to backtest a retirement in {city.name} against market history.
            </p>
            <div id="confidence-detail" class="hidden">
              <div id="confidence-tiers" class="flex flex-wrap items-center gap-1.5 mb-3">
                <span class="text-xs text-gray-400 mr-1">Lifestyle:</span>
                <button type="button" class="conf-tier-btn px-2.5 py-1 text-xs font-semibold rounded-full border border-sand-200 text-gray-600 transition-all" data-tier="budget">Lean FIRE</button>
                <button type="button" class="conf-tier-btn px-2.5 py-1 text-xs font-semibold rounded-full border border-sand-200 text-gray-600 transition-all" data-tier="comfortable">FIRE</button>
                <button type="button" class="conf-tier-btn px-2.5 py-1 text-xs font-semibold rounded-full border border-sand-200 text-gray-600 transition-all" data-tier="luxury">Fat FIRE</button>
              </div>
              <div id="confidence-headline" class="flex items-center gap-2 mb-2"></div>
              <p id="confidence-summary" class="text-sm text-gray-600"></p>
              <p id="confidence-divergence" class="hidden text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 mt-2 leading-snug"></p>
              <details class="mt-3">
                <summary class="text-xs text-gray-500 cursor-pointer hover:text-gray-700">
                  Backtest detail
                </summary>
                <div id="confidence-expanded" class="text-xs text-gray-600 mt-2 leading-relaxed pl-4 border-l-2 border-sand-200 space-y-1"></div>
              </details>
            </div>
          </div>
          <details class="mt-3">
            <summary class="text-xs text-gray-500 cursor-pointer hover:text-gray-700">
              How this is calculated
            </summary>
            <div class="text-xs text-gray-500 mt-2 leading-relaxed pl-4 border-l-2 border-sand-200 space-y-2">
              <p>
                This is a real historical backtest. We run your plan through <strong>every</strong>
                retirement-length window in US market history (1871–2022): a 75% stock / 25% bond
                portfolio, rebalanced annually, with withdrawals raised each year for that period's
                actual inflation. The success rate is the share of those historical start years in
                which the money lasted the full length without running out.
              </p>
              <p>
                Your <strong>confidence level</strong> sets the bar: at Balanced (90%), a survival
                rate of 90% or more reads "You can retire here", within 10 points below is "Close —
                worth a closer look", and lower is "Not quite yet". The same level sizes the
                "Needed to retire here" target. <strong>Retirement length</strong> also drives it —
                early retirees planning 40–50+ years see lower survival than the 30-year baseline.
              </p>
            </div>
          </details>
        </section>

        <!-- 4. City Tags (all expanded) -->
        <section>
          <h2 class="font-serif text-2xl font-bold text-brand-950 mb-4">
            Healthcare, Visa &amp; City Overview
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {tagEntries.map(([category, value]) => (
              <div class="flex items-center gap-3 bg-white rounded-xl border border-sand-200 px-4 py-3">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider w-20 shrink-0">{category}</span>
                <span class:list={['text-sm font-medium px-3 py-1 rounded-full', getTagColor(category, value)]}>
                  {value}
                </span>
              </div>
            ))}
          </div>

          <!-- Quick facts below tags -->
          <div class="mt-4 bg-white rounded-xl border border-sand-200 p-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              <div>
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Timezone</span>
                <p class="text-gray-800 mt-0.5">{city.quickFacts.timezone}</p>
              </div>
              <div>
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Currency</span>
                <p class="text-gray-800 mt-0.5">{city.quickFacts.currency}</p>
              </div>
              <div>
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Language</span>
                <p class="text-gray-800 mt-0.5">{city.quickFacts.language}</p>
              </div>
              <div>
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Avg. Temperature</span>
                <p class="text-gray-800 mt-0.5">{city.quickFacts.averageTemp}</p>
              </div>
              <div>
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Internet</span>
                <p class="text-gray-800 mt-0.5">{city.quickFacts.internetSpeed}</p>
              </div>
              <div>
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Airport</span>
                <p class="text-gray-800 mt-0.5">{city.quickFacts.nearestAirport}</p>
              </div>
              {!isDomestic && (
                <div class="sm:col-span-2">
                  <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Visa</span>
                  <p class="text-gray-800 mt-0.5">{city.quickFacts.visa}</p>
                </div>
              )}
            </div>
          </div>
        </section>

        <!-- 5. Compare & Related -->
        <CityFAQ city={city} faqs={faqQuestions} />
        <RelatedCities currentCity={city} allCities={allCities} />
      </div>

      <!-- Sidebar -->
      <div class="space-y-8">
        <ComparisonCTA currentCity={city} allCities={allCities} />

        <section class="bg-brand-950 rounded-2xl p-6 text-white">
          <h3 class="font-serif text-lg font-bold mb-2">See Where You Can Retire</h3>
          <p class="text-sm text-sand-300 mb-4">
            Enter your portfolio value and see which cities worldwide you can retire in.
          </p>
          <a
            href="/"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-white text-brand-700 text-sm font-semibold rounded-lg hover:bg-sand-50 transition-colors w-full justify-center"
          >
            Explore All Cities
          </a>
        </section>

        <a
          href={countryHubUrl}
          class="flex items-center justify-between bg-white rounded-xl border border-sand-200 p-4 hover:border-brand-300 hover:shadow-sm transition-all group"
        >
          <span class="text-sm font-semibold text-gray-700 group-hover:text-brand-700 transition-colors">
            See all cities in {city.country}
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-brand-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <a
          href={portfolioTierUrl}
          class="flex items-center justify-between bg-white rounded-xl border border-sand-200 p-4 hover:border-brand-300 hover:shadow-sm transition-all group"
        >
          <span class="text-sm font-semibold text-gray-700 group-hover:text-brand-700 transition-colors">
            All cities affordable on {nearestTier.label}
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-brand-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Newsletter capture (link variant — no iframe on SEO-heavy city routes) -->
  <section class="container-narrow pb-16 text-center">
    <div class="border-t border-sand-200 pt-10 max-w-xl mx-auto">
      <SubscribeCTA
        variant="link"
        utm="city_page"
        heading={`Want more cities like ${city.name}?`}
        subtext="Subscribe and we'll tell you when we add new destinations."
      />
    </div>
  </section>
</Layout>

<script>
  import { runBacktest } from '../../data/backtest';
  import { classifySurvival, requiredPortfolio, thresholdFromConf } from '../../data/retirementBands';
  import { adjustedLines, HEALTHCARE_LINE_INDEX } from '../../data/household';

  // Client-side: verdict + target from the historical backtest at the chosen confidence
  (function() {
    let portfolio = 0;
    let userPassiveIncome = 0;
    let horizon = 30;        // retirement length -> drives the backtest
    let confPct = 90;        // confidence level -> the ONE threshold

    // ─── Session-sticky personal inputs ───
    // The session (the user's latest explicit numbers this tab session) wins
    // on city pages — a URL here can be stale after back-navigation; a URL
    // param only seeds a key the session doesn't have yet (shared links).
    // The homepage uses the reverse precedence (URL wins — it's the entry
    // point). sessionStorage only: closing the tab restores the clean slate.
    function ssGet(key: string): string | null {
      try { return sessionStorage.getItem('pa:' + key); } catch (e) { return null; }
    }
    function ssSet(key: string, val: string | number | null) {
      try {
        if (val == null) sessionStorage.removeItem('pa:' + key);
        else sessionStorage.setItem('pa:' + key, String(val));
      } catch (e) { /* private mode */ }
    }
    function resolve(key: string, urlVal: string | null): string | null {
      const s = ssGet(key);
      if (s != null) return s;
      if (urlVal != null && urlVal !== '') { ssSet(key, urlVal); return urlVal; }
      return null;
    }

    const params = new URLSearchParams(window.location.search);
    const nwParam = resolve('portfolio', params.get('portfolio') || params.get('nw'));
    if (nwParam) {
      portfolio = parseInt(nwParam, 10) || 0;
    }
    const passiveParam = parseInt(resolve('passive', params.get('passive')) || '0', 10);
    if (passiveParam > 0) userPassiveIncome = passiveParam;
    const confParam = parseInt(resolve('conf', params.get('conf')) || '', 10);
    if (confParam === 80 || confParam === 90 || confParam === 95) confPct = confParam;
    const horizonParam = parseInt(resolve('horizon', params.get('horizon')) || '', 10);
    if (!isNaN(horizonParam) && horizonParam >= 20 && horizonParam <= 60) horizon = horizonParam;
    // The single threshold: gates the verdict AND sizes the target on every surface.
    const threshold = thresholdFromConf(confPct);

    // Lifestyle tier selected on the homepage. Default = 'comfortable' (FIRE).
    // The session stores the INTERNAL tier key; the URL uses the marketing key.
    const TIER_LABELS: Record<string, string> = { budget: 'Lean FIRE', comfortable: 'FIRE', luxury: 'Fat FIRE' };
    const TIER_FROM_URL: Record<string, string> = { leanfire: 'budget', fire: 'comfortable', fatfire: 'luxury' };
    const TIER_TO_URL: Record<string, string> = { budget: 'leanfire', comfortable: 'fire', luxury: 'fatfire' };
    let selectedTier = 'comfortable';
    const tierSession = ssGet('tier');
    const tierParamRaw = params.get('tier') || '';
    if (tierSession && TIER_LABELS[tierSession]) selectedTier = tierSession;
    else if (TIER_FROM_URL[tierParamRaw]) { selectedTier = TIER_FROM_URL[tierParamRaw]; ssSet('tier', selectedTier); }

    const rows = document.querySelectorAll('.fire-row');
    const prompt = document.getElementById('portfolio-prompt');
    const statusHeader = document.getElementById('status-header');

    // ─── Healthcare override (flat across tiers; null = use our estimate) ───
    let healthcareOverride: number | null = null;
    const hcRaw = resolve('hcusd', params.get('hcusd'));
    if (hcRaw !== null && hcRaw !== '' && !isNaN(parseInt(hcRaw, 10))) {
      let n = parseInt(hcRaw, 10);
      if (n < 0) n = 0; if (n > 5000) n = 5000;
      healthcareOverride = n;
    }
    const hcToggle = document.getElementById('hc-override-toggle') as HTMLInputElement | null;
    const hcField = document.getElementById('hc-override-field');
    const hcInput = document.getElementById('hc-override-input') as HTMLInputElement | null;
    if (healthcareOverride !== null) {
      if (hcToggle) hcToggle.checked = true;
      if (hcField) hcField.classList.remove('hidden');
      if (hcInput) hcInput.value = String(healthcareOverride);
    }
    function readHcOverride() {
      if (!hcToggle || !hcToggle.checked) { healthcareOverride = null; return; }
      const raw = (hcInput?.value || '').trim();
      if (raw === '') { healthcareOverride = null; return; }
      let n = parseInt(raw, 10);
      if (isNaN(n) || n < 0) n = 0;
      if (n > 5000) n = 5000;
      healthcareOverride = n;
    }
    // Mirror the override into the URL without a reload (so a copied link carries it).
    function persistHc() {
      const url = new URL(window.location.href);
      if (healthcareOverride == null) url.searchParams.delete('hcusd');
      else url.searchParams.set('hcusd', String(healthcareOverride));
      window.history.replaceState({}, '', url);
    }

    // ─── Household size (?adults): 1 = stored single-adult basis (default), 2 = two adults ───
    let adults = 1;
    const adultsResolved = resolve('adults', params.get('adults'));
    if (adultsResolved != null && parseInt(adultsResolved, 10) === 2) adults = 2;
    const adultsBtns = document.querySelectorAll('.adults-btn');
    function setAdultsActive() {
      adultsBtns.forEach((b) => {
        const active = parseInt(b.getAttribute('data-adults') || '', 10) === adults;
        b.classList.toggle('bg-brand-600', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-brand-600', active);
        b.classList.toggle('text-gray-600', !active);
        b.classList.toggle('border-sand-200', !active);
      });
      // State visibility: swap the one-person base note for the 2-adult indicator.
      document.querySelectorAll('.household-note').forEach((el) => el.classList.toggle('hidden', adults <= 1));
      document.querySelectorAll('.household-base-note').forEach((el) => el.classList.toggle('hidden', adults > 1));
    }
    // Mirror the household size into the URL without a reload (omit when 1).
    function persistAdults() {
      const url = new URL(window.location.href);
      if (adults <= 1) url.searchParams.delete('adults');
      else url.searchParams.set('adults', String(adults));
      window.history.replaceState({}, '', url);
    }
    setAdultsActive();

    // Mirror the effective (session-resolved) inputs into the URL so the
    // address bar and the Share buttons reflect what the page actually shows.
    function mirrorUrl() {
      const url = new URL(window.location.href);
      const put = (k: string, v: string | null) => {
        if (v == null) url.searchParams.delete(k); else url.searchParams.set(k, v);
      };
      put('portfolio', portfolio > 0 ? String(portfolio) : null);
      if (portfolio > 0) url.searchParams.delete('nw');
      put('passive', userPassiveIncome > 0 ? String(userPassiveIncome) : null);
      put('conf', confPct !== 90 ? String(confPct) : null);
      put('horizon', horizon !== 30 ? String(horizon) : null);
      put('tier', selectedTier !== 'comfortable' ? (TIER_TO_URL[selectedTier] || null) : null);
      put('hcusd', healthcareOverride != null ? String(healthcareOverride) : null);
      put('adults', adults > 1 ? String(adults) : null);
      if (url.href !== window.location.href) window.history.replaceState({}, '', url);
    }
    mirrorUrl();

    // Adjusted monthly cost for a tier. Order of operations: household scaling
    // first (per line item, via the shared adjustedLines), THEN the hcusd
    // override — the user's stated healthcare cost is authoritative and is NOT
    // multiplied; it replaces the (scaled) healthcare line. Floor = the
    // non-healthcare lines.
    function adjustedMonthlyFor(tier: string): number {
      const r = document.querySelector(`.fire-row[data-tier="${tier}"]`);
      if (adults <= 1) {
        // Single adult: exactly the pre-household code path.
        const mc = r ? parseInt(r.getAttribute('data-monthly-cost') || '0', 10) : 0;
        if (healthcareOverride == null) return mc;
        const hc = r ? parseInt(r.getAttribute('data-healthcare') || '0', 10) : 0;
        return (mc - hc) + Math.max(0, healthcareOverride);
      }
      // data-lines order (household.ts LINE ORDER): [housing, dining, groceries,
      // healthcare, transportation, entertainment, utilities, domesticHelp?,
      // luxuryExtras?].
      const lines: number[] = r ? JSON.parse(r.getAttribute('data-lines') || '[]') : [];
      const scaled = adjustedLines(lines, adults);
      const total = scaled.reduce((sum, n) => sum + n, 0);
      if (healthcareOverride == null) return total;
      return (total - (scaled[HEALTHCARE_LINE_INDEX] || 0)) + Math.max(0, healthcareOverride);
    }

    // Keep the Monthly Cost column priced even before a portfolio is set (the
    // verdict columns need a portfolio; the costs don't).
    function renderCostsOnly() {
      rows.forEach((row) => {
        const tier = row.getAttribute('data-tier') || '';
        const costEl = row.querySelector('.monthly-cost-val');
        if (costEl) (costEl as HTMLElement).textContent = '$' + adjustedMonthlyFor(tier).toLocaleString() + '/mo';
      });
    }

    // Back/forward cache re-sync: a bfcache-restored page can hold stale
    // adults/hcusd state if another page changed them since. (Fresh loads
    // re-run init, so only e.persisted needs handling; the other inputs are
    // only editable on the homepage and re-resolve there.)
    function wireBfcacheSync(rerender: () => void) {
      window.addEventListener('pageshow', (e) => {
        if (!(e as PageTransitionEvent).persisted) return;
        let changed = false;
        const sa = ssGet('adults');
        if (sa != null) {
          const next = sa === '2' ? 2 : 1;
          if (next !== adults) { adults = next; setAdultsActive(); changed = true; }
        }
        const sh = ssGet('hcusd');
        let nextHc: number | null = null;
        if (sh != null && sh !== '' && !isNaN(parseInt(sh, 10))) {
          nextHc = Math.max(0, Math.min(5000, parseInt(sh, 10)));
        }
        if (nextHc !== healthcareOverride) {
          healthcareOverride = nextHc;
          if (hcToggle) hcToggle.checked = nextHc != null;
          hcField?.classList.toggle('hidden', nextHc == null);
          if (hcInput) hcInput.value = nextHc == null ? '' : String(nextHc);
          changed = true;
        }
        if (changed) { mirrorUrl(); rerender(); }
      });
    }

    if (!portfolio || portfolio <= 0) {
      if (prompt) prompt.classList.remove('hidden');
      if (statusHeader) statusHeader.textContent = '';
      // No verdict without a portfolio, but let the controls toggle + persist
      // for later, and keep the Monthly Cost column priced for the selection.
      if (adults > 1 || healthcareOverride != null) renderCostsOnly();
      hcToggle?.addEventListener('change', () => { hcField?.classList.toggle('hidden', !hcToggle.checked); readHcOverride(); ssSet('hcusd', healthcareOverride); persistHc(); renderCostsOnly(); });
      hcInput?.addEventListener('input', () => { readHcOverride(); ssSet('hcusd', healthcareOverride); persistHc(); renderCostsOnly(); });
      adultsBtns.forEach((b) => b.addEventListener('click', () => {
        adults = parseInt(b.getAttribute('data-adults') || '', 10) === 2 ? 2 : 1;
        setAdultsActive(); ssSet('adults', adults); persistAdults(); renderCostsOnly();
      }));
      wireBfcacheSync(renderCostsOnly);
      return;
    }

    // ─── Verdict engine: historical-backtest survival + solver target per tier ───
    function annualSpendFor(tier: string): number {
      return Math.max(0, adjustedMonthlyFor(tier) * 12 - userPassiveIncome); // net of passive, override applied
    }
    function survivalFor(tier: string): number | null {
      return runBacktest({ initialPortfolio: portfolio, annualSpending: annualSpendFor(tier), horizonYears: horizon }).successRate;
    }
    // Portfolio needed to reach the chosen threshold (null if unreachable at this horizon).
    function neededFor(tier: string): number | null {
      return requiredPortfolio({ annualSpending: annualSpendFor(tier), horizonYears: horizon, targetSurvival: threshold });
    }
    // 4% rule benchmark — a fixed reference stat only (no longer a gate).
    function ruleBenchFor(tier: string): number {
      const spend = annualSpendFor(tier);
      return spend > 0 ? Math.round(spend / 0.04 / 1000) * 1000 : 0;
    }
    // Per-tier results — recomputed by applyAll() whenever the override changes.
    let tierSurvival: Record<string, number | null> = {};
    let tierNeeded: Record<string, number | null> = {};

    function fmt(n: number): string {
      if (n >= 1_000_000) {
        const m = n / 1_000_000;
        const formatted = m.toFixed(2).replace(/\.?0+$/, '');
        return '$' + formatted + 'M';
      }
      if (n >= 1_000) return '$' + Math.round(n / 1_000) + 'K';
      return '$' + n.toLocaleString();
    }

    function fmtPassiveIncome(n: number): string {
      if (n >= 1_000_000) return '$' + (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
      if (n >= 1_000) return '$' + Math.round(n / 1_000) + 'K';
      return '$' + n.toLocaleString();
    }

    // When passive income is active, relabel the table header and show a note
    if (userPassiveIncome > 0) {
      const note = document.getElementById('passive-income-note');
      const noteText = document.getElementById('passive-income-note-text');
      if (note && noteText) {
        noteText.textContent = `Your ${fmtPassiveIncome(userPassiveIncome)}/yr passive income is already netted out of the portfolio you'd need below.`;
        note.classList.remove('hidden');
      }
    }

    // Per-tier table + description render — re-runs whenever the override changes.
    const thPct = Math.round(threshold * 100);
    let currentTier = selectedTier;
    let renderConfidenceFn: ((tier: string) => void) | null = null;

    function renderTable() {
      rows.forEach((row) => {
        const tier = row.getAttribute('data-tier') || '';
        const adjMonthly = adjustedMonthlyFor(tier);
        const statusCell = row.querySelector('.fire-status');
        const fireNumberCell = row.querySelector('td:nth-child(2) span');
        const needed = tierNeeded[tier];

        // Monthly Cost cell reflects the override (same flat healthcare across tiers).
        const costEl = row.querySelector('.monthly-cost-val');
        if (costEl) (costEl as HTMLElement).textContent = '$' + adjMonthly.toLocaleString() + '/mo';

        // Prominent number = backtest target (consistent with the verdict by construction).
        if (fireNumberCell) {
          const ctx = `${thPct}% survival · ${horizon}yr · 4% rule ${fmt(ruleBenchFor(tier))}`;
          let gapLine: string;
          if (needed === null) gapLine = '<div class="text-[10px] text-gray-400 font-normal mt-0.5">unreachable at this horizon</div>';
          else if (portfolio >= needed) gapLine = '<div class="text-[10px] text-emerald-600 font-normal mt-0.5">you have enough</div>';
          else gapLine = `<div class="text-[10px] text-gray-500 font-normal mt-0.5">${fmt(needed - portfolio)} short</div>`;
          (fireNumberCell as HTMLElement).innerHTML = (needed === null ? '—' : fmt(needed)) +
            `<div class="text-[10px] text-gray-400 font-normal mt-0.5">${ctx}</div>` + gapLine;
        }

        // Actual withdrawal rate (what the backtest tests), on the adjusted spend.
        const wdRateEl = row.querySelector('.wd-rate');
        if (wdRateEl) {
          const netAnnual = Math.max(0, adjMonthly * 12 - userPassiveIncome);
          const wr = portfolio > 0 ? (netAnnual / portfolio) * 100 : 0;
          (wdRateEl as HTMLElement).textContent = `${wr.toFixed(1)}% of your portfolio`;
          wdRateEl.classList.remove('hidden');
        }

        if (!statusCell) return;

        // Status = the historical-backtest verdict at the chosen confidence.
        const survival = tierSurvival[tier];
        const band = classifySurvival(survival, threshold);
        const pct = survival === null ? null : Math.round(survival * 100);
        (row as HTMLElement).classList.remove('bg-emerald-50/50', 'bg-amber-50/40');
        if (band === 'retire') {
          statusCell.innerHTML = `<span class="inline-flex items-center gap-1.5 text-emerald-600 font-semibold text-sm"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>You can retire here${pct !== null ? ` · ${pct}%` : ''}</span>`;
          (row as HTMLElement).classList.add('bg-emerald-50/50');
        } else if (band === 'caution') {
          statusCell.innerHTML = `<span class="text-sm font-semibold text-amber-600">Close${pct !== null ? ` · ${pct}%` : ''}</span>`;
          (row as HTMLElement).classList.add('bg-amber-50/40');
        } else {
          statusCell.innerHTML = `<span class="text-sm text-gray-500">Not quite yet${pct !== null ? ` · ${pct}%` : ''}</span>`;
        }
      });

      // Lifestyle description cards: show the same backtest target + highlight.
      document.querySelectorAll('.lifestyle-desc').forEach((desc) => {
        const tier = desc.getAttribute('data-tier') as string;
        const row = document.querySelector(`.fire-row[data-tier="${tier}"]`);
        if (!row) return;
        const fireEl = desc.querySelector('.lifestyle-fire');
        if (fireEl) fireEl.textContent = tierNeeded[tier] === null ? '—' : fmt(tierNeeded[tier] as number);
        (desc as HTMLElement).classList.remove('border-emerald-200', 'bg-emerald-50/30');
        if (classifySurvival(tierSurvival[tier], threshold) === 'retire') {
          (desc as HTMLElement).classList.add('border-emerald-200', 'bg-emerald-50/30');
          (desc as HTMLElement).classList.remove('border-sand-200');
        } else {
          (desc as HTMLElement).classList.add('border-sand-200');
        }
      });
    }

    // Recompute survival/target for all tiers, then re-render table + panel.
    function applyAll() {
      tierSurvival = { budget: survivalFor('budget'), comfortable: survivalFor('comfortable'), luxury: survivalFor('luxury') };
      tierNeeded = { budget: neededFor('budget'), comfortable: neededFor('comfortable'), luxury: neededFor('luxury') };
      // Expose for FireStatusCard (define:vars, can't import). Same threshold everywhere.
      (window as any).__paTierSurvival = tierSurvival;
      (window as any).__paThreshold = threshold;
      (window as any).__paClassify = classifySurvival;
      window.dispatchEvent(new Event('pa:survival-ready'));
      renderTable();
      if (renderConfidenceFn) renderConfidenceFn(currentTier);
    }

    // ─── Real historical backtest (replaces the old static lookup) ───
    const confText = document.getElementById('confidence-text');
    const confDetail = document.getElementById('confidence-detail');
    const confHeadline = document.getElementById('confidence-headline');
    const confSummary = document.getElementById('confidence-summary');
    const confDivergence = document.getElementById('confidence-divergence');
    const confExpanded = document.getElementById('confidence-expanded');

    if (confDetail && confHeadline && confSummary) {
      const check = '<svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>';

      function setTierActive(tier: string) {
        document.querySelectorAll('.conf-tier-btn').forEach((b) => {
          const active = b.getAttribute('data-tier') === tier;
          b.classList.toggle('bg-brand-600', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('border-brand-600', active);
          b.classList.toggle('text-gray-600', !active);
          b.classList.toggle('border-sand-200', !active);
        });
      }

      // Render the confidence panel for an EXPLICIT tier. No auto-downgrade: the
      // binary verdict and the backtest both use exactly this tier's spend.
      function renderConfidence(tier: string) {
        const row = document.querySelector(`.fire-row[data-tier="${tier}"]`);
        if (!row || !confDetail || !confHeadline || !confSummary) return;
        const annualSpending = annualSpendFor(tier);

        // VERDICT = historical-backtest survival vs the chosen confidence threshold.
        const result = runBacktest({ initialPortfolio: portfolio, annualSpending, horizonYears: horizon });
        const band = classifySurvival(result.successRate, threshold);
        const needed = tierNeeded[tier]; // solver target at the same threshold (or null)
        const actualRatePct = portfolio > 0 ? ((annualSpending / portfolio) * 100).toFixed(1).replace(/\.0$/, '') : '0';

        confText?.classList.add('hidden');
        confDetail.classList.remove('hidden');
        setTierActive(tier);
        confDivergence?.classList.add('hidden'); // target now agrees with the verdict; no bridge needed

        // Headline derives ONLY from the survival band — it is impossible to show
        // "You can retire here" unless survival >= the chosen threshold.
        if (band === 'retire') {
          confHeadline.innerHTML = `${check}<span class="text-lg font-bold text-emerald-600">You can retire here</span>`;
        } else if (band === 'caution') {
          confHeadline.innerHTML = '<span class="text-lg font-bold text-amber-600">Close — worth a closer look</span>';
        } else {
          confHeadline.innerHTML = '<span class="text-lg font-bold text-gray-600">Not quite yet</span>';
        }

        if (result.successRate === null) {
          confSummary.textContent = `Not enough market history for a ${horizon}-year backtest (only ${result.totalSequences} complete periods available). Try a shorter retirement length.`;
          if (confExpanded) confExpanded.innerHTML = '';
          return;
        }

        const successPct = Math.round(result.successRate * 100);
        const thPct = Math.round(threshold * 100);
        let gapTxt = '';
        if (needed != null) gapTxt = portfolio >= needed ? ` You have enough (target ${fmt(needed)}).` : ` You'd need ${fmt(needed)} — about ${fmt(needed - portfolio)} more.`;
        confSummary.innerHTML = `At a <strong>${TIER_LABELS[tier]}</strong> lifestyle, your plan survived <strong>${successPct}%</strong> of ${result.totalSequences} historical ${horizon}-year periods (your ${thPct}% target).${gapTxt}`;

        if (confExpanded) {
          confExpanded.innerHTML =
            `<p>${result.survivedSequences} of ${result.totalSequences} historical start years (1871–2022) funded ${horizon} years of inflation-adjusted spending at ${fmt(annualSpending)}/yr — 75% stocks / 25% bonds, rebalanced annually.</p>` +
            `<p>Median ending balance: <strong>${fmt(result.medianEndingBalance ?? 0)}</strong>. Worst case: <strong>${fmt(result.worstCaseEndingBalance ?? 0)}</strong>.</p>` +
            `<p>You'd withdraw about <strong>${actualRatePct}%</strong> in year one. The 4% rule is a familiar benchmark (≈ ${fmt(ruleBenchFor(tier))}); this verdict comes from how your plan held across market history.</p>`;
        }
      }

      // Expose so applyAll() can refresh the panel after an override change.
      renderConfidenceFn = renderConfidence;

      // Live tier toggle (survival for all tiers is already computed).
      document.querySelectorAll('.conf-tier-btn').forEach((b) => {
        b.addEventListener('click', () => { currentTier = b.getAttribute('data-tier') || 'comfortable'; ssSet('tier', currentTier); renderConfidence(currentTier); });
      });
    }

    // Healthcare override → recompute every tier + re-render table/panel in place.
    hcToggle?.addEventListener('change', () => { hcField?.classList.toggle('hidden', !hcToggle.checked); readHcOverride(); ssSet('hcusd', healthcareOverride); persistHc(); applyAll(); });
    hcInput?.addEventListener('input', () => { readHcOverride(); ssSet('hcusd', healthcareOverride); persistHc(); applyAll(); });

    // Household size → recompute every tier + re-render table/panel in place.
    adultsBtns.forEach((b) => b.addEventListener('click', () => {
      adults = parseInt(b.getAttribute('data-adults') || '', 10) === 2 ? 2 : 1;
      setAdultsActive(); ssSet('adults', adults); persistAdults(); applyAll();
    }));

    wireBfcacheSync(applyAll);

    // Initial paint (defaults to the tier selected on the homepage).
    applyAll();
  })();
</script>

<script define:vars={{ paCitySlug: city.slug }}>
  // GA4 engagement depth: city_depth_3 fires once per session when the visitor
  // has viewed 3 UNIQUE city pages (unique slugs, so reloading one city never
  // triggers it). This script exists only on /cities/[slug] routes, so country
  // guides, roundups, and blog posts can never count toward it.
  try {
    let seen = [];
    try { seen = JSON.parse(sessionStorage.getItem('pa_city_views') || '[]'); } catch (e) { seen = []; }
    if (!Array.isArray(seen)) seen = [];
    if (!seen.includes(paCitySlug)) {
      seen.push(paCitySlug);
      sessionStorage.setItem('pa_city_views', JSON.stringify(seen));
    }
    if (seen.length >= 3 && !sessionStorage.getItem('pa_city_depth_fired') && typeof gtag === 'function') {
      gtag('event', 'city_depth_3');
      sessionStorage.setItem('pa_city_depth_fired', '1');
    }
  } catch (e) { /* sessionStorage unavailable (private mode) — skip tracking */ }
</script>
